---
/**
 * Carte projet réutilisable (FOCUS_PLAN_PAGES 1.3 / 2.3 / 3.5).
 * Étape 2 — le test de feeling. Chorégraphie de hover en CSS pur :
 *   1. média scale(1.07) + bascule de filtre
 *   2. tracé des marques de cadrage (transform scale depuis le sommet)
 *   3. remontée des infos (client + type)
 *
 * Médias : props `video` (.webm) + `poster` optionnels. Tant qu'aucun
 * asset n'est fourni, on rend un poster placeholder généré (dégradé +
 * grain + label) qui pane légèrement au hover pour évoquer la vidéo.
 * Quand le vrai .webm arrive : passer `video` + `poster`, rien d'autre.
 *
 * Textes = PLACEHOLDERS.
 */
import FrameMarks from "./FrameMarks.astro";

interface Props {
  client: string;       // ex. "Projet Alpha" (affiché en display)
  type: string;         // ex. "Film de marque" (mono, accent au hover)
  index: string;        // ex. "01"
  total: string;        // ex. "04"
  href?: string;
  cardVideo?: string;   // vidéo de couverture locale (lecture auto, boucle) — prioritaire
  video?: string;       // chemin .webm (optionnel tant qu'absent)
  poster?: string;      // chemin poster (optionnel)
  ratio?: string;       // ratio CSS, ex "4 / 5" ou "16 / 9"
  category?: string;    // slug pour le filtrage (ex. "film-de-marque")
  span?: number;        // colonnes occupées dans la grille 12 col (optionnel)
  embed?: { provider: "youtube" | "vimeo"; id: string; start?: number };
  staticCover?: boolean; // true = vignette seule (pas de lecture auto) — ex. roue
  comingSoon?: boolean;  // projet en attente → visuel « Prochainement »
}
const {
  client,
  type,
  index,
  total,
  href = "/projets",
  cardVideo,
  video,
  poster,
  ratio = "4 / 5",
  category,
  span,
  embed,
  staticCover = false,
  comingSoon = false,
} = Astro.props;
const cardStyle = `--card-ratio:${ratio}` + (span ? `;grid-column:span ${span}` : "");

// Couverture animée via embed (lecture auto / muet / boucle / sans contrôles).
// Chargé en lazy (data-embed-src posé par MotionEngine quand la carte approche).
let embedSrc = "";
let embedThumb = "";
if (embed?.provider === "youtube") {
  const s = embed.start ? `&start=${embed.start}` : "";
  embedSrc = `https://www.youtube-nocookie.com/embed/${embed.id}?autoplay=1&mute=1&loop=1&playlist=${embed.id}&controls=0&modestbranding=1&playsinline=1&rel=0&disablekb=1&iv_load_policy=3${s}`;
  embedThumb = `https://i.ytimg.com/vi/${embed.id}/maxresdefault.jpg`;
} else if (embed?.provider === "vimeo") {
  embedSrc = `https://player.vimeo.com/video/${embed.id}?background=1&autoplay=1&muted=1&loop=1&dnt=1`;
}
---

<article class="card" style={cardStyle} data-category={category} data-reveal>
  <a class="card__link" href={href} aria-label={`${client}, ${type}`}>
    <div class="card__media">
      {comingSoon ? (
        <div class="coming-soon card__soon" aria-hidden="true">
          <div class="coming-soon__grad"></div>
          <span class="coming-soon__label">Prochainement</span>
        </div>
      ) : staticCover ? (
        embedThumb ? (
          <img class="card__embed-thumb" src={embedThumb} alt="" loading="lazy" aria-hidden="true" />
        ) : poster ? (
          <img class="card__embed-thumb" src={poster} alt="" loading="lazy" aria-hidden="true" />
        ) : (
          <div class="card__placeholder" aria-hidden="true">
            <span class="card__placeholder-label label">[ VIDÉO {index} ]</span>
          </div>
        )
      ) : cardVideo ? (
        <video
          class="card__video"
          data-autoplay
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={embedThumb || poster}
        >
          <source src={cardVideo} type="video/mp4" />
        </video>
      ) : embed ? (
        <div class="card__embed">
          {embedThumb && (
            <img class="card__embed-thumb" src={embedThumb} alt="" loading="lazy" aria-hidden="true" />
          )}
          <iframe
            class="card__embed-frame"
            data-embed-src={embedSrc}
            title={client}
            allow="autoplay; fullscreen; picture-in-picture"
            loading="lazy"
            tabindex="-1"
            aria-hidden="true"
          ></iframe>
        </div>
      ) : video ? (
        <video
          class="card__video"
          data-autoplay
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster}
        >
          <source src={video} />
        </video>
      ) : (
        <div class="card__placeholder" aria-hidden="true">
          <span class="card__placeholder-label label">[ VIDÉO {index} ]</span>
        </div>
      )}

      <!-- scrim bas pour lisibilité des infos -->
      <div class="card__scrim" aria-hidden="true"></div>

      <!-- signature : marques de cadrage tracées au hover -->
      <span class="mark tl"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
      <span class="mark br"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>

      <!-- infos qui remontent au hover -->
      <div class="card__overlay">
        <span class="card__client">{client}</span>
        <span class="card__type">{type}</span>
      </div>
    </div>
  </a>

  <div class="card__meta">
    <span class="card__name">{client}</span>
    <span class="count">N°{index} / {total}</span>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 1rem; }

  .card__link { display: block; }

  .card__media {
    position: relative;
    aspect-ratio: var(--card-ratio);
    overflow: hidden;
    background: var(--bg-deep);
    border-radius: 2px;
  }

  /* Média (vidéo réelle ou placeholder) — repos filtré, hover éclairci.
     transform/filter only, easing & durée du système. */
  .card__video,
  .card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.62);
    transform: scale(1);
    transition:
      transform var(--dur-reveal) var(--ease),
      filter var(--dur-reveal) var(--ease);
  }

  /* Couverture embed (YouTube/Vimeo) — iframe recadrée en cover, non cliquable
     (les clics passent au lien de la carte). Thumb en dessous = fallback. */
  .card__embed { position: absolute; inset: 0; }
  .card__embed-thumb,
  .card__embed-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    pointer-events: none;
    filter: saturate(0.8) brightness(0.6);
    transform: scale(1);
    transition:
      transform var(--dur-reveal) var(--ease),
      filter var(--dur-reveal) var(--ease);
  }
  .card__embed-thumb { z-index: 0; }
  .card__embed-frame { z-index: 1; background: transparent; }

  /* Placeholder visuel : dégradé cinéma + grain (via ::before). */
  .card__placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 100% at 70% -10%, rgba(40,70,120,0.45) 0%, rgba(20,20,28,0) 55%),
      radial-gradient(90% 90% at 10% 115%, rgba(255,30,99,0.10) 0%, rgba(20,20,28,0) 55%),
      linear-gradient(155deg, #1a1a22 0%, #131318 60%, #0e0e12 100%);
    background-size: 140% 140%;
    background-position: 50% 50%;
  }
  .card__placeholder-label {
    position: relative;
    color: var(--text-faint);
    letter-spacing: 0.22em;
  }

  .card__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(to top, rgba(14,14,18,0.85) 0%, rgba(14,14,18,0) 45%);
    opacity: 0.5;
    transition: opacity var(--dur-reveal) var(--ease);
  }

  /* Marques de cadrage — repos scale 0, tracées au hover. */
  .card__media .mark { position: absolute; width: 12px; height: 12px; z-index: 3; }
  .card__media .mark.tl { top: 14px; left: 14px; }
  .card__media .mark.br { bottom: 14px; right: 14px; }

  /* Infos en bas, remontent au hover. */
  .card__overlay {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity var(--dur-reveal) var(--ease),
      transform var(--dur-reveal) var(--ease);
  }
  .card__client {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.5rem;
    line-height: 0.95;
    color: var(--text);
  }
  .card__type {
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    color: var(--accent);
  }

  /* — HOVER (le test de feeling) — */
  .card__link:hover .card__video,
  .card__link:hover .card__placeholder,
  .card__link:hover .card__embed-thumb,
  .card__link:hover .card__embed-frame,
  .card__link:focus-visible .card__video,
  .card__link:focus-visible .card__placeholder,
  .card__link:focus-visible .card__embed-thumb,
  .card__link:focus-visible .card__embed-frame {
    transform: scale(1.07);
    filter: saturate(1) brightness(0.8);
  }
  /* léger pan du placeholder pour évoquer la vidéo qui tourne */
  .card__link:hover .card__placeholder {
    background-position: 40% 60%;
    transition:
      transform var(--dur-reveal) var(--ease),
      filter var(--dur-reveal) var(--ease),
      background-position 4s var(--ease);
  }
  .card__link:hover .card__scrim,
  .card__link:focus-visible .card__scrim { opacity: 1; }

  /* « Prochainement » : léger zoom au hover (le dégradé garde son anim interne) */
  .card__soon { transition: transform var(--dur-reveal) var(--ease); }
  .card__link:hover .card__soon,
  .card__link:focus-visible .card__soon { transform: scale(1.04); }

  .card__link:hover .card__overlay,
  .card__link:focus-visible .card__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  /* tracé des marques (transform scale depuis le sommet) */
  .card__link:hover .mark .arm-h,
  .card__link:focus-visible .mark .arm-h {
    transform: scaleX(1);
    transition: transform var(--dur-sign) var(--ease);
  }
  .card__link:hover .mark .arm-v,
  .card__link:focus-visible .mark .arm-v {
    transform: scaleY(1);
    transition: transform var(--dur-sign) var(--ease);
  }

  .card__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .card__name {
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.82rem;
    color: var(--text);
  }
</style>
