---
/**
 * Bande de logos clients — défilement continu (FOCUS_PLAN_PAGES 1.2, adapté).
 * Animation : boucle infinie (GSAP, pilotée par MotionEngine) + pause au hover.
 *
 * Logos : prop `logos` = tableau de { name, src? }.
 *   - src fourni  → <img> (filtre grayscale, s'éclaircit au hover)
 *   - sinon       → slot placeholder « [ LOGO 0X ] »
 * Tant qu'aucun logo n'est fourni, 6 slots placeholder. PLACEHOLDERS.
 */
interface LogoItem {
  name: string;
  src?: string;
  /** Dimensions réelles du fichier. Sans elles, un logo pas encore chargé fait
   *  0 px de large : la bande se calcule sur une largeur fausse et les logos
   *  apparaissent en décalant tout. Avec elles, la place est réservée d'emblée. */
  w?: number;
  h?: number;
  /** Opacité au repos propre à ce logo (0.8 par défaut). */
  opacite?: number;
  /** Logo noir sur fond transparent : on l'inverse en blanc, sinon il
   *  disparaît sur la bande sombre quelle que soit son opacité. */
  inverser?: boolean;
}
interface Props {
  logos?: LogoItem[];
  /** Intitulé lu par les lecteurs d'écran : il dépend de la langue. */
  label?: string;
}
const {
  label = "Ils nous font confiance",
  logos = [
    { name: "Logo 01" },
    { name: "Logo 02" },
    { name: "Logo 03" },
    { name: "Logo 04" },
    { name: "Logo 05" },
    { name: "Logo 06" },
  ],
} = Astro.props;

// 2 groupes identiques → translation xPercent -50 = boucle sans couture.
// `repeats` = nb de copies des logos DANS chaque groupe : assez pour qu'un
// groupe dépasse la largeur de l'écran même avec peu de logos (sinon la bande
// n'occupe qu'une partie de la largeur et laisse du vide à droite).
const repeats = Math.max(3, Math.ceil(22 / logos.length));
---

<section class="marquee" aria-label={label}>
  <div class="marquee__track" data-marquee="26">
    {Array.from({ length: 2 }).map(() => (
      <div class="marquee__group" aria-hidden="true">
        {Array.from({ length: repeats }).flatMap(() =>
          logos.map((logo) => (
            <div class="marquee__item">
              {logo.src ? (
                <img
                  class="marquee__logo"
                  src={logo.src}
                  alt={logo.name}
                  width={logo.w}
                  height={logo.h}
                  loading="lazy"
                  decoding="async"
                  style={[
                    logo.opacite !== undefined && `--logo-op:${logo.opacite}`,
                    logo.inverser && `--logo-inv:1`,
                  ].filter(Boolean).join(";") || undefined}
                />
              ) : (
                <span class="marquee__placeholder">[ {logo.name.toUpperCase()} ]</span>
              )}
            </div>
          ))
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    background: var(--bg-base);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(22px, 3vw, 38px);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__group {
    display: flex;
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
    padding-right: clamp(40px, 6vw, 88px);
  }
  .marquee__item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: clamp(30px, 3.4vw, 46px);
  }
  /* Vrais logos (mono-chrome, s'éclaircissent au survol de la bande). */
  .marquee__logo {
    height: 100%;
    width: auto;
    object-fit: contain;
    filter: grayscale(1) invert(var(--logo-inv, 0));
    opacity: var(--logo-op, 0.8);
    transition: opacity var(--dur-reveal) var(--ease), filter var(--dur-reveal) var(--ease);
  }
  .marquee:hover .marquee__logo { opacity: 1; filter: grayscale(0) invert(var(--logo-inv, 0)); }

  /* Slot placeholder en attendant les vrais logos. */
  .marquee__placeholder {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding-inline: 1.4em;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.74rem;
    color: var(--text-faint);
    white-space: nowrap;
  }
</style>
