---
/**
 * À propos (FOCUS_PLAN_PAGES §5) — fusion "about" + "talent" (esprit Outline,
 * original). Hero plein écran avec grande image d'équipe en fond, récit avec
 * photos flottantes, mosaïque de photos éparpillées, chiffres, savoir-faire.
 * Images : public/images/a-propos/ (team.jpg + photo-01..06.jpg). Placeholders
 * + fallback onerror tant que les fichiers ne sont pas déposés.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SouvenirsBoard from "../components/SouvenirsBoard.astro";

const figures = [
  { n: "120", s: "+", label: "Projets livrés" },
  { n: "10", s: "", label: "Ans d'expérience" },
  { n: "60", s: "+", label: "Clients" },
  { n: "5", s: "", label: "Formats maîtrisés" },
];
// Valeurs d'équipe / culture (inspirées de l'esprit, réécrites pour Eleusis).
const values = [
  { title: "Famille", desc: "Plus qu'un studio, une bande. On se dit les choses, on s'entraide sans même qu'on le demande, et on construit ensemble ce qui nous fait vibrer." },
  { title: "L'obsession du détail", desc: "Un projet n'est jamais fini tant qu'on n'est pas fiers d'y mettre notre nom. On vise l'excellence par envie, pas par obligation." },
  { title: "Zéro ego", desc: "On crée avec les gens, pas au-dessus d'eux. On n'est pas là pour impressionner, mais pour faire ensemble. Et on attend la même chose de ceux qui nous rejoignent." },
  { title: "Liberté", desc: "On poursuit ce qui nous inspire. Pas d'horaires figés ni de bureau imposé : on se concentre sur le travail qui ressemble à du jeu. Si on ne s'amuse pas, c'est qu'on s'y prend mal." },
];

// Disposition « Souvenirs » (page À propos) — éclatée sur toute la largeur.
// Le CONTENU (photos + légendes) vient de src/data/souvenirs.ts (partagé).
const souvenirsLayout = [
  { t: "4%",  l: "3%",  w: "clamp(150px, 16vw, 230px)", r: "-2deg",   cap: "Nos débuts",            align: "left",  p: 16 },
  { t: "30%", l: "31%", w: "clamp(150px, 17vw, 240px)", r: "2deg",    cap: "Sur le terrain",        align: "left",  p: -24 },
  { t: "2%",  l: "67%", w: "clamp(150px, 16vw, 230px)", r: "1.5deg",  cap: "Grandir ensemble",      align: "right", p: 22 },
  { t: "55%", l: "9%",  w: "clamp(150px, 17vw, 240px)", r: "3deg",    cap: "L'obsession du détail", align: "left",  p: -14 },
  { t: "58%", l: "40%", w: "clamp(150px, 16vw, 220px)", r: "-1.5deg", cap: "La passion d'abord",    align: "left",  p: 26 },
  { t: "48%", l: "71%", w: "clamp(150px, 17vw, 240px)", r: "-3deg",   cap: "La liberté de créer",   align: "right", p: -18 },
];

const team = [
  { name: "Olivier Shapiro", role: "Réalisateur", instagram: "https://www.instagram.com/oliviershapiro/", photo: true },
  { name: "Arnaud Charrière", role: "Assistant et droniste", instagram: "https://www.instagram.com/arnaud_drone/", photo: true },
  { name: "[ Prénom Nom ]", role: "[ Rôle ]", instagram: "", photo: false },
  { name: "[ Prénom Nom ]", role: "[ Rôle ]", instagram: "", photo: false },
];

// Showreel ouvert par la notification (section Récit). PLACEHOLDER tant que le
// vrai showreel n'est pas fourni — remplacer par :
//   embed YouTube : { embed: { provider: "youtube", id: "XXXXXXXXXXX" } }
//   embed Vimeo   : { embed: { provider: "vimeo", id: "123456789" } }
//   fichier local : { video: "/videos/showreel.mp4" }
const showreel: { embed?: { provider: "youtube" | "vimeo"; id: string }; video?: string } = {
  // Vide tant que le vrai showreel n'est pas fourni → affiche « Prochainement ».
};
const srEmbed = showreel.embed
  ? showreel.embed.provider === "youtube"
    ? `https://www.youtube-nocookie.com/embed/${showreel.embed.id}?autoplay=1&rel=0&playsinline=1`
    : `https://player.vimeo.com/video/${showreel.embed.id}?autoplay=1`
  : "";
const srType = srEmbed ? "embed" : showreel.video ? "video" : "soon";
const srSrc = srEmbed || showreel.video || "";
---

<BaseLayout
  title="À propos · Eleusis"
  description="Eleusis, studio de réalisation vidéo en Suisse romande. L'équipe, notre approche, notre savoir-faire."
  active="/a-propos"
>
  <!-- ============ HERO : grande image d'équipe en fond ============ -->
  <section class="ab-hero">
    <div class="ab-hero__bg" aria-hidden="true">
      <div class="media-ph"><span class="media-ph__label label">[ PHOTO ÉQUIPE ]</span></div>
      <img src="/images/a-propos/team.webp" alt="" onerror="this.style.display='none'" />
    </div>
    <div class="ab-hero__scrim" aria-hidden="true"></div>
    <div class="container ab-hero__inner">
      <p class="label label--accent" data-reveal>// Studio</p>
      <h1 class="ab-hero__title" data-split>À propos</h1>
      <p class="ab-hero__lead" data-reveal>
        Une équipe, une obsession : raconter votre histoire en images.
      </p>
    </div>
  </section>

  <!-- ============ RÉCIT + photos flottantes ============ -->
  <section class="ab-story">
    <figure class="ab-float ab-float--1" data-parallax="26">
      <div class="ab-float__inner">
        <div class="media-ph"><span class="media-ph__label label">[ PHOTO ]</span></div>
        <img src="/images/a-propos/photo-01.webp" alt="" loading="lazy" onerror="this.style.display='none'" />
      </div>
    </figure>
    <figure class="ab-float ab-float--2" data-parallax="-26">
      <div class="ab-float__inner">
        <div class="media-ph"><span class="media-ph__label label">[ PHOTO ]</span></div>
        <img src="/images/a-propos/photo-02.webp" alt="" loading="lazy" onerror="this.style.display='none'" />
      </div>
    </figure>

    <div class="container ab-story__inner">
      <p class="label label--accent" data-reveal>// Récit</p>
      <h2 class="ab-story__quote" data-split data-frameword="block">Chaque image sert une histoire</h2>
      <div class="ab-story__prose">
        <p data-reveal>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.</p>
        <p data-reveal>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.</p>
        <p data-reveal>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore.</p>
      </div>

      <!-- Notification cliquable → ouvre le showreel -->
      <button class="sr-notif" type="button" data-reveal data-sr-type={srType} data-sr-src={srSrc} aria-haspopup="dialog" aria-label="Lancer le showreel">
        <span class="sr-notif__icon" aria-hidden="true"></span>
        <span class="sr-notif__body">
          <span class="sr-notif__title">Showreel</span>
          <span class="sr-notif__sub">Un aperçu de notre travail, cliquez pour lancer</span>
        </span>
        <span class="sr-notif__dot" aria-hidden="true"></span>
      </button>
    </div>
  </section>

  <!-- ============ NOS VALEURS ============ -->
  <section class="ab-values">
    <div class="container">
      <p class="label label--accent ab-values__label" data-reveal>// Nos valeurs</p>
      <div class="ab-values__list">
        {values.map((v) => (
          <article class="ab-value" data-reveal>
            <h3 class="ab-value__title">{v.title}</h3>
            <p class="ab-value__desc text-muted">{v.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ L'ÉQUIPE (talent) ============ -->
  <section class="ab-team">
    <div class="container">
      <div class="ab-team__head">
        <p class="label label--accent" data-reveal>// L'équipe</p>
        <h2 class="ab-team__title" data-split>Les visages derrière ELEUSIS</h2>
      </div>
      <div class="ab-team__grid">
        {team.map((m, i) => {
          const Tag = m.instagram ? "a" : "div";
          return (
            <figure class="ab-member" data-reveal>
              <Tag
                class:list={["ab-member__photo", { "is-link": m.instagram }]}
                href={m.instagram || undefined}
                target={m.instagram ? "_blank" : undefined}
                rel={m.instagram ? "noopener noreferrer" : undefined}
                aria-label={m.instagram ? `${m.name}, Instagram` : undefined}
              >
                <div class="media-ph">
                  <span class:list={["media-ph__label label", { "ab-member__invite": !m.photo }]}>
                    {m.photo ? "[ PHOTO ]" : (<>Peut-être toi<br />le prochain ?</>)}
                  </span>
                </div>
                {m.photo && (
                  <img src={`/images/a-propos/Les-membres/team-0${i + 1}.webp`} alt={m.name} loading="lazy" onerror="this.style.display='none'" />
                )}
                <span class="mark tl is-drawn"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
                <span class="mark br is-drawn"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
                {m.instagram && <span class="ab-member__ig" aria-hidden="true">Instagram ↗</span>}
              </Tag>
              <figcaption class="ab-member__cap">
                <span class="ab-member__name">{m.name}</span>
                <span class="ab-member__role">{m.role}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ EN COULISSES : scatter compact de petites photos ============ -->
  <section class="ab-coulisses">
    <div class="container">
      <p class="label label--accent ab-coulisses__label" data-reveal>// Souvenirs</p>
      <SouvenirsBoard layout={souvenirsLayout} />
    </div>
  </section>

  <!-- ============ CHIFFRES ============ -->
  <section class="ab-figures">
    <div class="container ab-figures__grid">
      {figures.map((f) => (
        <div class="ab-fig" data-reveal>
          <span class="ab-fig__num" data-count={f.n} data-suffix={f.s}>0</span>
          <span class="ab-fig__label label">{f.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Modal showreel (ouvert depuis la notification) -->
  <div class="sr-modal" id="sr-modal" hidden role="dialog" aria-modal="true" aria-label="Showreel">
    <span class="sr-puck" id="sr-puck" aria-hidden="true"><i class="sr-puck__tri"></i></span>
    <button class="sr-modal__close" type="button" aria-label="Fermer le showreel">&times;</button>
    <div class="sr-modal__frame">
      <div class="sr-modal__inner" id="sr-modal-inner"></div>
      <span class="mark tl is-drawn"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
      <span class="mark br is-drawn"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
    </div>
  </div>
</BaseLayout>

<style>
  .media-ph {
    position: absolute; inset: 0; display: grid; place-items: center;
    background:
      radial-gradient(120% 100% at 72% -10%, rgba(48,92,165,0.40) 0%, rgba(20,20,28,0) 58%),
      linear-gradient(155deg, #1a1a22 0%, #131318 60%, #0e0e12 100%);
  }
  .media-ph__label { color: var(--text-faint); letter-spacing: 0.24em; }

  /* ---------- Hero plein écran (image équipe) ---------- */
  .ab-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .ab-hero__bg { position: absolute; inset: 0; }
  .ab-hero__bg img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) brightness(0.75);
    animation: ab-kenburns 24s ease-in-out infinite alternate; /* zoom cinématique lent */
  }
  @keyframes ab-kenburns { from { transform: scale(1.02); } to { transform: scale(1.13); } }
  .ab-hero__scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(80% 60% at 80% -10%, rgba(40,70,120,0.30) 0%, rgba(20,20,28,0) 55%),
      linear-gradient(to top, rgba(15,15,17,0.94) 0%, rgba(15,15,17,0.25) 55%, rgba(15,15,17,0.5) 100%);
  }
  .ab-hero__inner { position: relative; z-index: 2; padding-bottom: clamp(48px, 9vh, 120px); padding-top: calc(var(--nav-h) + 40px); }
  .ab-hero__title { font-size: clamp(3.5rem, 12vw, 9rem); letter-spacing: 0.01em; margin: 0.1em 0 0.4em; }
  .ab-hero__lead { font-family: var(--font-mono); font-size: clamp(1rem, 1.6vw, 1.25rem); color: var(--text); max-width: 40ch; }

  /* ---------- Récit + photos flottantes ---------- */
  .ab-story {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(55% 46% at 50% 50%, rgba(48,92,165,0.14) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(80px, 13vw, 190px);
    text-align: center;
  }
  .ab-story__inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; }
  .ab-story__quote { font-size: clamp(2rem, 5.5vw, 4.4rem); margin: 0.4em 0 1em; max-width: 18ch; }
  .ab-story__prose { max-width: 60ch; display: flex; flex-direction: column; gap: 1.4em; }
  .ab-story__prose p { color: var(--text-muted); font-size: clamp(0.95rem, 1.3vw, 1.05rem); margin: 0 auto; }

  .ab-float { position: absolute; z-index: 1; width: clamp(120px, 13vw, 200px); }
  .ab-float__inner {
    position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 2px;
    background: var(--bg-deep); box-shadow: 0 26px 60px -28px rgba(0,0,0,0.8);
  }
  .ab-float__inner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ab-float--1 { left: clamp(8px, 4vw, 80px); top: 16%; }
  .ab-float--1 .ab-float__inner { transform: rotate(-5deg); }
  .ab-float--2 { right: clamp(8px, 4vw, 80px); bottom: 14%; }
  .ab-float--2 .ab-float__inner { transform: rotate(5deg); }
  @media (max-width: 1080px) { .ab-float { display: none; } }

  /* ---------- Nos valeurs ---------- */
  .ab-values {
    background:
      radial-gradient(55% 46% at 100% 50%, rgba(48,92,165,0.14) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(64px, 11vw, 150px);
  }
  .ab-values__label { margin-bottom: clamp(20px, 3vw, 36px); }
  .ab-values__list { border-top: 1px solid var(--line); }
  .ab-value {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    align-items: start;
    gap: clamp(20px, 5vw, 80px);
    padding: clamp(26px, 3.6vw, 48px) 0;
    border-bottom: 1px solid var(--line);
  }
  .ab-value__title {
    font-family: var(--font-display); font-weight: 800; text-transform: none;
    line-height: 1; font-size: clamp(1.5rem, 3vw, 2.6rem);
    transition: color var(--dur-sign) var(--ease), transform var(--dur-sign) var(--ease);
  }
  .ab-value__desc { font-family: var(--font-mono); font-size: 0.88rem; line-height: 1.7; max-width: 52ch; }
  .ab-value:hover .ab-value__title { color: var(--accent); transform: translateX(8px); }
  @media (max-width: 720px) { .ab-value { grid-template-columns: 1fr; gap: 14px; } }

  /* ---------- L'équipe ---------- */
  .ab-team { background: var(--bg-base); padding-block: clamp(56px, 9vw, 130px); }
  .ab-team__head { margin-bottom: clamp(28px, 4vw, 52px); }
  .ab-team__title { font-size: clamp(2rem, 4.5vw, 3.6rem); margin-top: 0.4em; max-width: 16ch; }
  /* toutes les cartes de la même taille (pas de hiérarchie) — s'adapte au nb de membres */
  .ab-team__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: clamp(20px, 3vw, 44px); align-items: start; }
  .ab-member { margin: 0; }
  .ab-member__photo {
    display: block;
    position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 2px; background: var(--bg-deep);
  }
  .ab-member__photo.is-link { cursor: pointer; }
  /* indice « Instagram ↗ » au survol (membres avec compte) */
  .ab-member__ig {
    position: absolute; left: 12px; bottom: 12px; z-index: 3;
    font-family: var(--font-mono); font-weight: 500; text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.62rem; color: var(--text);
    background: rgba(8, 8, 11, 0.5); padding: 0.4em 0.7em; border-radius: 2px;
    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
    opacity: 0; transform: translateY(6px);
    transition: opacity var(--dur-sign) var(--ease), transform var(--dur-sign) var(--ease);
  }
  .ab-member__photo.is-link:hover .ab-member__ig { opacity: 1; transform: none; }
  /* Emplacement libre : invitation à rejoindre l'équipe (au lieu de « PHOTO ») */
  .ab-member__invite {
    max-width: 82%; text-align: center; line-height: 1.5;
    letter-spacing: 0.14em; color: var(--text-muted);
  }
  .ab-member__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) brightness(0.85); transition: filter var(--dur-reveal) var(--ease), transform var(--dur-reveal) var(--ease); }
  .ab-member:hover .ab-member__photo img { filter: saturate(1) brightness(1); transform: scale(1.04); }
  .ab-member__photo .mark { position: absolute; width: 12px; height: 12px; z-index: 2; }
  .ab-member__photo .mark.tl { top: 12px; left: 12px; }
  .ab-member__photo .mark.br { bottom: 12px; right: 12px; }
  .ab-member__cap { display: flex; flex-direction: column; gap: 0.2em; margin-top: 1em; }
  .ab-member__name { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; font-size: 1.05rem; }
  .ab-member__role { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.7rem; color: var(--accent); }
  /* focus : au survol de la grille, les autres membres s'estompent */
  .ab-member { transition: opacity var(--dur-sign) var(--ease); }
  .ab-team__grid:hover .ab-member { opacity: 0.4; }
  .ab-team__grid:hover .ab-member:hover { opacity: 1; }
  @media (max-width: 760px) {
    .ab-team__grid { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- Souvenirs (planche partagée via SouvenirsBoard) ---------- */
  .ab-coulisses { background: var(--bg-base); padding-bottom: clamp(64px, 11vw, 150px); }
  .ab-coulisses__label { margin-bottom: clamp(16px, 2vw, 28px); text-align: center; }

  /* ---------- Chiffres ---------- */
  .ab-figures { background: var(--bg-base); padding-block: clamp(48px, 7vw, 100px); }
  .ab-figures__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 40px); }
  .ab-fig { display: flex; flex-direction: column; gap: 0.5em; padding-top: clamp(20px, 2.5vw, 32px); border-top: 1px solid var(--line-strong); }
  .ab-fig__num { font-family: var(--font-display); font-weight: 800; line-height: 0.9; font-size: clamp(2.6rem, 6vw, 5rem); color: var(--text); }
  .ab-fig__label { color: var(--text-muted); }
  @media (max-width: 680px) { .ab-figures__grid { grid-template-columns: 1fr 1fr; gap: 28px; } }

  /* ---------- Notification « Showreel » ---------- */
  .sr-notif {
    align-self: center;
    margin-top: clamp(34px, 6vw, 70px);
    display: inline-flex; align-items: center; gap: 16px; text-align: left;
    padding: 14px 24px 14px 16px;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 12px; position: relative; cursor: pointer;
    box-shadow: 0 18px 50px -24px rgba(0,0,0,0.85);
    transition: transform var(--dur-sign) var(--ease), border-color var(--dur-sign) var(--ease), box-shadow var(--dur-sign) var(--ease);
    animation: sr-breathe 2.8s ease-in-out infinite;
  }
  .sr-notif:hover {
    transform: translateY(-3px);
    border-color: var(--accent-border);
    box-shadow: 0 26px 64px -22px rgba(0,0,0,0.9), 0 0 0 1px var(--accent-border);
  }
  .sr-notif__icon {
    flex: none; width: 44px; height: 44px; border-radius: 50%;
    background: var(--accent); display: grid; place-items: center;
    box-shadow: 0 8px 26px -6px var(--accent-glow);
  }
  .sr-notif__icon::after {
    content: ""; width: 0; height: 0; margin-left: 3px;
    border-style: solid; border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent var(--accent-text);
  }
  .sr-notif__body { display: flex; flex-direction: column; gap: 3px; }
  .sr-notif__title { font-family: var(--font-mono); font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.82rem; color: var(--text); }
  .sr-notif__sub { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); }
  .sr-notif__dot {
    position: absolute; top: 11px; right: 12px; width: 8px; height: 8px;
    border-radius: 50%; background: var(--accent); animation: sr-ping 2s ease-out infinite;
  }
  @keyframes sr-ping {
    0% { box-shadow: 0 0 0 0 rgba(255,30,99,0.55); }
    70% { box-shadow: 0 0 0 11px rgba(255,30,99,0); }
    100% { box-shadow: 0 0 0 0 rgba(255,30,99,0); }
  }
  @keyframes sr-breathe {
    0%, 100% { box-shadow: 0 18px 50px -24px rgba(0,0,0,0.85), 0 0 0 0 rgba(255,30,99,0); }
    50% { box-shadow: 0 18px 50px -24px rgba(0,0,0,0.85), 0 0 0 4px rgba(255,30,99,0.08); }
  }

  /* ---------- Modal showreel ---------- */
  .sr-modal {
    position: fixed; inset: 0; z-index: 200;
    display: grid; place-items: center; padding: clamp(20px, 5vw, 80px);
    background: rgba(8,8,11,0.86);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    opacity: 0; visibility: hidden; /* l'ouverture/fermeture est pilotée par GSAP */
  }
  .sr-modal[hidden] { display: none; }
  .sr-modal__frame {
    position: relative; width: 100%; max-width: 1040px; aspect-ratio: 16 / 9;
    background: #000; border-radius: 2px; z-index: 1; will-change: clip-path;
  }
  .sr-modal__inner { position: absolute; inset: 0; overflow: hidden; border-radius: 2px; }
  .sr-modal__inner :global(iframe), .sr-modal__inner :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .sr-modal__frame .mark { position: absolute; width: 16px; height: 16px; z-index: 2; }
  .sr-modal__frame .mark.tl { top: -8px; left: -8px; }
  .sr-modal__frame .mark.br { bottom: -8px; right: -8px; }
  /* disque rose (avec triangle « play ») qui glisse depuis la notif puis « accouche » de la vidéo */
  .sr-puck {
    position: fixed; top: 0; left: 0; display: none;
    border-radius: 50%; background: var(--accent); z-index: 3; pointer-events: none;
    box-shadow: 0 0 70px -4px var(--accent-glow), 0 0 0 1px rgba(255,30,99,0.45);
    place-items: center;
  }
  .sr-puck__tri {
    width: 0; height: 0; margin-left: 3px;
    border-style: solid; border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent #fff;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.25));
  }
  .sr-modal__close {
    position: absolute; top: clamp(14px, 3vw, 26px); right: clamp(14px, 3vw, 26px); z-index: 5;
    width: 46px; height: 46px; border-radius: 50%;
    background: rgba(255,255,255,0.08); color: #fff; font-size: 26px; line-height: 1;
    display: grid; place-items: center; cursor: pointer;
    transition: background var(--dur-sign) var(--ease);
  }
  .sr-modal__close:hover { background: var(--accent); }
</style>

<script is:inline>
  (function () {
    var notif = document.querySelector(".sr-notif");
    var modal = document.getElementById("sr-modal");
    var inner = document.getElementById("sr-modal-inner");
    if (!notif || !modal || !inner) return;
    var closeBtn = modal.querySelector(".sr-modal__close");

    var puck = document.getElementById("sr-puck");
    var tri = puck.querySelector(".sr-puck__tri");
    var frame = modal.querySelector(".sr-modal__frame");
    var inner2 = inner;
    var icon = notif.querySelector(".sr-notif__icon");

    function injectVideo() {
      var type = notif.getAttribute("data-sr-type");
      var src = notif.getAttribute("data-sr-src");
      if (type === "soon") {
        inner.innerHTML = '<div class="coming-soon" aria-hidden="true"><div class="coming-soon__grad"></div><span class="coming-soon__label">Prochainement</span></div>';
        return true;
      }
      if (!src) return false;
      if (type === "embed") {
        inner.innerHTML = '<iframe src="' + src + '" title="Showreel" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen></iframe>';
      } else {
        inner.innerHTML = '<video src="' + src + '" controls autoplay playsinline></video>';
      }
      return true;
    }
    function lock() { if (window.lenis) window.lenis.stop(); document.body.style.overflow = "hidden"; }
    function unlock() { if (window.lenis) window.lenis.start(); document.body.style.overflow = ""; }

    var PUCK_GROW = 1.45; // facteur d'agrandissement du disque une fois au centre

    function open() {
      if (!injectVideo()) return;
      modal.hidden = false;
      lock();
      var g = window.gsap;
      if (!g) { modal.style.opacity = "1"; modal.style.visibility = "visible"; return; }

      var ir = icon.getBoundingClientRect();
      var size = ir.width;
      var fr = frame.getBoundingClientRect();
      var cx = fr.left + fr.width / 2, cy = fr.top + fr.height / 2;
      // le cercle de révélation démarre au rayon réel du disque agrandi → la vidéo
      // semble jaillir « de l'intérieur » du disque.
      var rStart = (size / 2) * PUCK_GROW;
      var rMax = Math.hypot(fr.width, fr.height) / 2 + 12;

      g.killTweensOf([modal, frame, inner2, puck, tri]);
      g.set(modal, { autoAlpha: 0 });
      // cadre totalement masqué (rayon 0) tant que le disque n'est pas arrivé
      g.set(frame, { autoAlpha: 1, scale: 1, clipPath: "circle(0px at 50% 50%)" });
      g.set(inner2, { scale: 1.12, transformOrigin: "50% 50%" });
      g.set(puck, { display: "grid", width: size, height: size, x: ir.left, y: ir.top, scale: 1, autoAlpha: 1, transformOrigin: "50% 50%" });
      g.set(tri, { autoAlpha: 1, scale: 1, transformOrigin: "40% 50%" });

      var ARRIVE = 0.9; // instant où le disque atteint le centre

      var tl = g.timeline();
      // fond
      tl.to(modal, { autoAlpha: 1, duration: 0.45, ease: "power2.out" }, 0);
      // 1) anticipation : le disque se ramasse légèrement
      tl.to(puck, { scale: 0.84, duration: 0.18, ease: "power2.in" }, 0.04);
      // 2) il glisse jusqu'au centre en grossissant (trajet principal, bien fluide)
      tl.to(puck, { x: cx - size / 2, y: cy - size / 2, scale: PUCK_GROW, duration: 0.7, ease: "power3.inOut" }, 0.2);
      // 3) le triangle « play » se dilate et s'efface juste avant l'arrivée
      tl.to(tri, { scale: 1.7, autoAlpha: 0, duration: 0.3, ease: "power2.out" }, ARRIVE - 0.18);
      // 4) à l'arrivée seulement : la vidéo s'ouvre depuis l'intérieur du disque
      tl.fromTo(frame,
        { clipPath: "circle(" + rStart + "px at 50% 50%)" },
        { clipPath: "circle(" + rMax + "px at 50% 50%)", duration: 0.9, ease: "expo.out", immediateRender: false }, ARRIVE);
      tl.to(inner2, { scale: 1, duration: 1.0, ease: "expo.out" }, ARRIVE);
      // 5) le disque s'estompe pendant la révélation
      tl.to(puck, { autoAlpha: 0, scale: PUCK_GROW * 1.25, duration: 0.5, ease: "power2.out",
        onComplete: function () { g.set(puck, { display: "none" }); } }, ARRIVE + 0.04);
    }

    function close() {
      unlock();
      var g = window.gsap;
      function done() { modal.hidden = true; inner.innerHTML = ""; if (g) g.set([modal, frame, inner2, puck, tri], { clearProps: "all" }); }
      if (!g) { modal.style.opacity = ""; modal.style.visibility = ""; done(); return; }
      g.killTweensOf([modal, frame, inner2, puck, tri]);
      g.set(puck, { display: "none" });
      var fr = frame.getBoundingClientRect();
      var rStart = Math.min(fr.width, fr.height) * 0.18;
      var tl = g.timeline({ onComplete: done });
      // la vidéo se referme en cercle puis le fond s'efface
      tl.to(frame, { clipPath: "circle(" + rStart + "px at 50% 50%)", duration: 0.4, ease: "power3.in" }, 0);
      tl.to(inner2, { scale: 1.1, duration: 0.4, ease: "power3.in" }, 0);
      tl.to(modal, { autoAlpha: 0, duration: 0.34, ease: "power2.in" }, 0.16);
    }

    notif.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    modal.addEventListener("click", function (e) { if (e.target === modal) close(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !modal.hidden) close(); });
  })();
</script>
