---
/** Project page, English version.
 *  Le gabarit est partagé : components/pages/Fiche.astro */
import Fiche from "../../../components/pages/Fiche.astro";
import { projects } from "../../../data/projects";

export function getStaticPaths() {
  const reels = projects.filter((p) => !p.placeholder);
  return reels.map((p) => ({
    params: { slug: p.slug },
    props: { project: p, others: reels.filter((x) => x.slug !== p.slug).slice(0, 2) },
  }));
}

const { project, others } = Astro.props;
---

<Fiche project={project} others={others} lang="en" />
