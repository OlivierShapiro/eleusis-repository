---
/**
 * Page projet — gabarit (FOCUS_PLAN_PAGES §3, révisé).
 * - En-tête compact, titre centré, section courte (pas d'image de fond).
 * - Vidéo principale CONTENUE (16:9, centrée, visible en entier) + reveal scroll.
 * - Galerie d'images au placement éditorial original + animations (clip, parallax,
 *   décalages).
 * Réf. d'esprit : page projet Outline. Contenus = PLACEHOLDERS.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectFeature from "../components/ProjectFeature.astro";

const meta = [
  ["Client", "[CLIENT]"],
  ["Type", "Film de marque"],
  ["Année", "[ANNÉE]"],
  ["Rôle", "[RÔLE]"],
];
const credits = [
  ["Réalisation", "[NOM]"],
  ["Image", "[NOM]"],
  ["Montage", "[NOM]"],
  ["Étalonnage", "[NOM]"],
  ["Musique", "[NOM]"],
];
---

<BaseLayout
  title="Projet Alpha · Eleusis"
  description="Étude de cas · Projet Alpha, réalisation Eleusis."
  active="/projets"
>
  <!-- ============ EN-TÊTE COMPACT (centré, sans image) ============ -->
  <section class="pj-head">
    <div class="container pj-head__inner">
      <p class="label label--accent" data-reveal>// Réalisation</p>
      <h1 class="pj-head__title" data-split>Projet Alpha</h1>
      <p class="pj-head__meta" data-reveal>
        {meta.map(([k, v], i) => (
          <>
            {i > 0 && <span class="pj-sep"> · </span>}
            <span class="pj-meta-k">{k} :</span> <span class="text-muted">{v}</span>
          </>
        ))}
      </p>
    </div>
  </section>

  <!-- ============ BANDE D'IMAGES (défilement en diagonale, AVANT la vidéo) ============ -->
  <section class="pj-strip">
    <div class="pj-strip__tilt">
      <div class="pj-strip__track" data-marquee="34">
        {Array.from({ length: 2 }).map(() => (
          <div class="pj-strip__group" aria-hidden="true">
            {["01", "02", "03", "04", "05", "06"].map((n) => (
              <div class="pj-strip__item">
                <div class="media-ph"><span class="media-ph__label label">[ IMAGE {n} ]</span></div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ VIDÉO PRINCIPALE (contenue + reveal) ============ -->
  <section class="pj-film">
    <div class="container">
      <div class="pj-film__frame" data-clip>
        <div class="clip__inner media-ph">
          <span class="media-ph__label label">[ VIDÉO PROJET ]</span>
        </div>
        <span class="mark tl is-drawn"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
        <span class="mark br is-drawn"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
      </div>
      <p class="pj-film__cap label" data-reveal>// Film complet · [DURÉE]</p>
    </div>
  </section>

  <!-- ============ NOTRE APPROCHE (centré) ============ -->
  <section class="pj-approche">
    <div class="container pj-approche__inner">
      <p class="label label--accent" data-reveal>// Approche</p>
      <h2 class="pj-approche__title" data-split>Notre approche</h2>
      <p class="pj-approche__body text-muted" data-reveal>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua.
      </p>
    </div>
  </section>

  <!-- ============ DÉTAILS / CRÉDITS ============ -->
  <section class="pj-credits">
    <div class="container">
      <p class="label label--accent" data-reveal>// Crédits</p>
      <dl class="pj-credits__list">
        {credits.map(([role, name]) => (
          <div class="pj-credits__row" data-reveal>
            <dt class="pj-credits__role">{role}</dt>
            <dd class="pj-credits__name">{name}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ PROJET SUIVANT ============ -->
  <section class="pj-next">
    <div class="container pj-next__head" data-reveal>
      <span class="label">Projet suivant</span>
      <span class="label label--accent">→ Projet Beta</span>
    </div>
    <ProjectFeature client="Projet Beta" type="Social / Reel" index="02" total="06" height="78vh" href="/projet-modele" />
  </section>
</BaseLayout>

<style>
  .media-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 100% at 72% -10%, rgba(48,92,165,0.42) 0%, rgba(20,20,28,0) 58%),
      radial-gradient(90% 90% at 10% 115%, rgba(255,30,99,0.06) 0%, rgba(20,20,28,0) 55%),
      linear-gradient(155deg, #1a1a22 0%, #131318 60%, #0e0e12 100%);
  }
  .media-ph__label { color: var(--text-faint); letter-spacing: 0.24em; }

  /* ---------- En-tête compact centré ---------- */
  .pj-head {
    background:
      radial-gradient(70% 120% at 50% -20%, rgba(48,92,165,0.18) 0%, rgba(18,18,20,0) 60%),
      var(--bg-base);
    padding-top: calc(var(--nav-h) + clamp(36px, 7vh, 80px));
    padding-bottom: clamp(28px, 5vh, 56px);
    text-align: center;
  }
  .pj-head__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    letter-spacing: 0.01em;
    margin: 0.3em 0 0.6em;
  }
  .pj-head__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    max-width: none;
  }
  .pj-meta-k { color: var(--text); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.7rem; }
  .pj-sep { color: var(--accent); }

  /* ---------- Vidéo principale contenue ---------- */
  .pj-film {
    background: var(--bg-base);
    padding-bottom: clamp(64px, 10vw, 130px);
  }
  .pj-film__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 1080px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-deep);
  }
  .pj-film__frame .clip__inner { position: absolute; inset: 0; }
  .pj-film__frame .mark { position: absolute; width: 14px; height: 14px; z-index: 2; }
  .pj-film__frame .mark.tl { top: 16px; left: 16px; }
  .pj-film__frame .mark.br { bottom: 16px; right: 16px; }
  .pj-film__cap {
    max-width: 1080px;
    margin: 1.2em auto 0;
    color: var(--text-muted);
  }

  /* ---------- Bande d'images (défilement EN DIAGONALE, sans lignes) ---------- */
  .pj-strip {
    overflow: hidden;
    background:
      radial-gradient(70% 44% at 50% 50%, rgba(48,92,165,0.16) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(56px, 9vw, 120px); /* respire : la vidéo n'est plus collée */
  }
  /* le ruban est incliné → défilement de travers */
  .pj-strip__tilt { transform: rotate(-4.5deg); width: 118%; margin-left: -9%; }
  .pj-strip__track { display: flex; width: max-content; will-change: transform; }
  .pj-strip__group { display: flex; align-items: center; gap: clamp(14px, 1.8vw, 28px); padding-right: clamp(14px, 1.8vw, 28px); }
  .pj-strip__item {
    position: relative;
    flex: none;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-deep);
  }
  /* tailles + décalages variés → casse la grille, plus créatif */
  .pj-strip__item:nth-child(3n + 1) { height: clamp(150px, 20vw, 230px); }
  .pj-strip__item:nth-child(3n + 2) { height: clamp(116px, 15vw, 176px); transform: translateY(30px); }
  .pj-strip__item:nth-child(3n + 3) { height: clamp(172px, 23vw, 264px); transform: translateY(-20px); }

  /* ---------- Notre approche (centré) ---------- */
  .pj-approche {
    background:
      radial-gradient(60% 46% at 50% 50%, rgba(48,92,165,0.16) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(64px, 11vw, 150px);
    text-align: center;
  }
  .pj-approche__inner { display: flex; flex-direction: column; align-items: center; }
  .pj-approche__title { font-size: clamp(2rem, 5vw, 3.6rem); margin: 0.4em 0 0.6em; }
  .pj-approche__body { font-size: clamp(0.98rem, 1.4vw, 1.15rem); max-width: 54ch; }

  /* ---------- Crédits ---------- */
  .pj-credits {
    background:
      radial-gradient(55% 45% at 100% 50%, rgba(48,92,165,0.10) 0%, rgba(18,18,20,0) 55%),
      var(--bg-base);
    padding-block: clamp(56px, 9vw, 130px);
  }
  .pj-credits__list { margin-top: clamp(28px, 4vw, 48px); border-top: 1px solid var(--line); max-width: 640px; }
  .pj-credits__row {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(14px, 1.6vw, 20px) 0;
    border-bottom: 1px solid var(--line);
  }
  .pj-credits__role {
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .pj-credits__name { font-family: var(--font-mono); font-size: 0.86rem; color: var(--text); }

  /* ---------- Projet suivant ---------- */
  .pj-next { background: var(--bg-base); padding-top: clamp(40px, 7vw, 100px); }
  .pj-next__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: clamp(20px, 3vw, 36px);
  }
</style>
