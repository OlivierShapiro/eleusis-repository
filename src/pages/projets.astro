---
/**
 * Projets (FOCUS_PLAN_PAGES §2, refonte) — en-tête à fond vidéo +
 * « roue de cartes » : catégories au-dessus (déclencheurs au survol),
 * cartes en éventail/arc en bas. Au survol d'une catégorie : spin rapide +
 * les projets de la catégorie grandissent au centre, les autres reculent.
 * Cartes en vignette statique (perf). Dégradés bleus en arrière-plan.
 * 6 projets. Contenus = PLACEHOLDERS.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SouvenirsBoard from "../components/SouvenirsBoard.astro";
import { projects } from "../data/projects";

const total = String(projects.length).padStart(2, "0");

// Disposition « En coulisses » (page Projets) — même contenu que la page
// À propos (src/data/souvenirs.ts) mais éparpillé AUTREMENT (plus colonné).
const coulissesLayout = [
  { t: "10%", l: "5%",  w: "clamp(150px, 15vw, 220px)", r: "3deg",    cap: "Sur le tournage", align: "left",  p: -20 },
  { t: "46%", l: "1%",  w: "clamp(150px, 16vw, 235px)", r: "-2.5deg", cap: "L'équipe",        align: "left",  p: 18 },
  { t: "1%",  l: "37%", w: "clamp(150px, 16vw, 230px)", r: "1.5deg",  cap: "En repérage",     align: "left",  p: 24 },
  { t: "53%", l: "39%", w: "clamp(150px, 15vw, 215px)", r: "-3deg",   cap: "Direction",       align: "right", p: -16 },
  { t: "6%",  l: "72%", w: "clamp(150px, 16vw, 235px)", r: "2.5deg",  cap: "Au montage",      align: "right", p: 20 },
  { t: "50%", l: "74%", w: "clamp(150px, 15vw, 220px)", r: "-1.5deg", cap: "Coulisses",       align: "right", p: -22 },
];

const baseFilters = [
  { label: "Tous", value: "all" },
  { label: "Brand Film", value: "brand-film" },
  { label: "Publicité", value: "publicite" },
  { label: "Corporate", value: "corporate" },
  { label: "Documentaire", value: "documentaire" },
];
// Disposition des clips sur la timeline de montage : t = piste (1 = V1, 2 = V2),
// x = point d'entrée et w = durée, en % de la durée totale. Calibré pour un
// étagement naturel (les clips d'une même piste ne se chevauchent jamais).
const clips = [
  { t: 1, x: 0,  w: 22 },
  { t: 2, x: 16, w: 20 },
  { t: 1, x: 26, w: 24 },
  { t: 2, x: 42, w: 16 },
  { t: 1, x: 54, w: 20 },
  { t: 2, x: 64, w: 30 },
];
// Graduations de la règle (durée fictive du « montage » : 2 min).
const ticks = Array.from({ length: 21 }, (_, k) => k * 5);
const tcMarks = [
  { x: 0, l: "00:00" }, { x: 25, l: "00:30" }, { x: 50, l: "01:00" },
  { x: 75, l: "01:30" }, { x: 100, l: "02:00" },
];

// Composition de la mosaique : chaque projet occupe des colonnes precises
// d'une grille de 12, avec un decalage vertical propre. Trois bandes de deux,
// dont les colonnes ne se chevauchent jamais. Le vide fait partie du dessin :
// c'est lui qui donne l'air compose plutot que tabulaire.
const mosaique = [
  { col: "1 / 8",   decal: 0,   ar: "16 / 9" },
  { col: "9 / 13",  decal: 96,  ar: "3 / 2"  },
  { col: "3 / 10",  decal: 44,  ar: "16 / 9" },
  { col: "10 / 13", decal: 0,   ar: "4 / 5"  },
  { col: "1 / 6",   decal: 34,  ar: "3 / 2"  },
  { col: "7 / 13",  decal: 92,  ar: "16 / 9" },
];

const counts: Record<string, number> = { all: projects.length };
for (const p of projects) counts[p.category] = (counts[p.category] || 0) + 1;
const filters = baseFilters.map((f) => ({
  ...f,
  count: String(counts[f.value] || 0).padStart(2, "0"),
}));
---

<BaseLayout
  title="Projets · Eleusis"
  description="Sélection de réalisations Eleusis : films de marque, social, clips, documentaires."
  active="/projets"
>
  <!-- ============ EN-TÊTE (fond vidéo) ============ -->
  <section class="phead">
    <video class="phead__bg" data-autoplay autoplay muted loop playsinline preload="metadata">
      <source src="/videos/projets-bg.mp4" type="video/mp4" />
    </video>
    <div class="phead__scrim" aria-hidden="true"></div>
    <div class="container phead__inner">
      <p class="label label--accent" data-reveal>// Sélection</p>
      <h1 class="phead__title" data-split>Projets</h1>
    </div>
  </section>

  <!-- ============ ROUE DE CARTES ============ -->
  <section class="projects">
    <div class="container">
      <!-- Catégories au-dessus (déclencheurs) -->
      <div class="cats" role="group" aria-label="Catégories de projets" data-reveal>
        <div class="cats__row">
          {filters.map((f, i) => (
            <button class="cat" type="button" data-filter={f.value} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="cat__label">{f.label}</span>
              <span class="cat__count">{f.count}</span>
            </button>
          ))}
          <span class="sigframe" aria-hidden="true">
            <span class="mark tl"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
            <span class="mark br"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
          </span>
        </div>
      </div>

    </div>

    <!-- Mosaique : composition asymetrique, une bande de deux par rangee.
         Placee hors du conteneur pour gagner la largeur des marges. -->
    <div class="mo" id="mo" data-reveal>
      {projects.map((p, i) => (
        <a
          class:list={["mo__item", { "is-soon": p.placeholder }]}
          style={`--col:${mosaique[i].col};--decal:${mosaique[i].decal}px;--ar:${mosaique[i].ar}`}
          data-i={i}
          data-category={p.category}
          href={p.placeholder ? "/projets" : `/projets/${p.slug}`}
          aria-label={`${p.title}, ${p.placeholder ? "a venir" : p.cardType}`}
        >
          <span class="mo__frame">
            {p.placeholder ? (
              <span class="coming-soon">
                <span class="coming-soon__grad"></span>
                <span class="coming-soon__label">Prochainement</span>
              </span>
            ) : (
              <video src={p.cardVideo} muted loop playsinline preload="metadata"></video>
            )}
            <span class="mark tl" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
            <span class="mark br" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
          </span>
          <span class="mo__cap">
            <span class="mo__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="mo__titre">{p.title}</span>
            <span class="mo__meta">
              {p.placeholder ? "A venir" : p.cardType}{p.year ? " · " + p.year : ""}
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ EN COULISSES : mini galerie BTS ============ -->
  <section class="bts">
    <div class="container">
      <div class="bts__head" data-reveal>
        <p class="label label--accent">// En coulisses</p>
        <p class="bts__hint text-muted">L'envers du décor, sur le terrain.</p>
      </div>
      <SouvenirsBoard layout={coulissesLayout} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- En-tête fond vidéo ---------- */
  .phead { position: relative; overflow: hidden; background: #0f0f11;
    padding-top: calc(var(--nav-h) + clamp(56px, 14vh, 170px)); padding-bottom: clamp(48px, 9vw, 110px); }
  .phead__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8) brightness(0.5); }
  .phead__scrim { position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 78% -8%, rgba(40,70,120,0.28) 0%, rgba(20,20,28,0) 50%),
      linear-gradient(to top, rgba(15,15,17,0.92) 0%, rgba(15,15,17,0.35) 55%, rgba(15,15,17,0.6) 100%); }
  .phead__inner { position: relative; z-index: 2; }
  .phead__title { font-size: clamp(3.5rem, 14vw, 11rem); letter-spacing: 0.01em; margin-top: 0.1em; }

  /* ---------- Section roue (dégradés bleus en fond) ---------- */
  .projects {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(52% 44% at 100% 50%, rgba(52,98,175,0.26) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(52% 44% at 0% 50%, rgba(52,98,175,0.20) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-bottom: clamp(48px, 8vw, 110px);
  }

  /* ---------- Catégories : barre de régie ----------
     Passées du gros display à du mono petit et espacé, dans le meme langage
     que les incrustations du mur. Séparées par de fins traits verticaux et
     posées sur une réglure, comme un bandeau de commande. */
  .cats { padding-block: clamp(24px, 3.6vw, 44px); }
  .cats__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0; /* l'espacement vient du padding des items */
    padding-bottom: 14px;
  }
  /* réglure fine sous la barre, arrêtée avant les bords */
  .cats__row::after {
    content: "";
    position: absolute; left: 12%; right: 12%; bottom: 0; height: 1px;
    background: linear-gradient(to right, rgba(255,255,255,0) 0%, var(--line) 18%, var(--line) 82%, rgba(255,255,255,0) 100%);
  }
  .cat {
    position: relative;
    display: inline-flex; align-items: baseline; gap: 0.55em;
    padding: 0.4em clamp(13px, 1.9vw, 26px);
    font-family: var(--font-mono); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.16em;
    font-size: 0.82rem; line-height: 1;
    color: var(--text-faint);
    transition: color var(--dur-sign) var(--ease);
  }
  /* trait vertical entre deux catégories */
  .cat + .cat::before {
    content: "";
    position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 1px; height: 10px; background: var(--line-strong);
  }
  .cat:hover, .cat[aria-pressed="true"] { color: var(--text); }
  .cat__count {
    font-family: var(--font-mono); font-weight: 500;
    font-size: 0.62em; letter-spacing: 0.06em; color: var(--accent);
    align-self: flex-start; margin-top: -0.1em;
  }

  /* ---------- MOSAIQUE : composition asymetrique ----------
     Grille de 12 colonnes, trois bandes de deux projets. Les largeurs et les
     decalages verticaux viennent des donnees, pas du CSS : c'est ce qui donne
     une page composee plutot qu'un tableau regulier. */
  .mo {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: start;
    gap: clamp(30px, 4.5vw, 74px) clamp(16px, 2.2vw, 38px);
    width: min(94vw, 1560px);
    margin: clamp(26px, 4vw, 56px) auto 0;
  }

  .mo__item {
    grid-column: var(--col);
    margin-top: var(--decal, 0);
    display: block;
    transition: opacity var(--dur-sign) var(--ease);
  }

  .mo__frame {
    position: relative; display: block;
    aspect-ratio: var(--ar, 16 / 9);
    overflow: hidden; border-radius: 2px;
    background: var(--bg-deep);
    box-shadow: 0 22px 54px -30px rgba(0,0,0,0.9);
    transition: box-shadow 0.55s var(--ease);
  }
  .mo__frame :global(video),
  .mo__frame :global(.coming-soon) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .mo__frame :global(video) {
    object-fit: cover; display: block;
    /* au repos : retenu et desature. La couleur revient au survol. */
    filter: grayscale(0.7) brightness(0.62);
    transform: scale(1.02);
    transition: filter 0.6s var(--ease), transform 0.7s var(--ease);
  }
  .mo__item:hover .mo__frame :global(video),
  .mo__item:focus-visible .mo__frame :global(video) {
    filter: grayscale(0) brightness(1);
    transform: scale(1.05);
  }
  .mo__item:hover .mo__frame,
  .mo__item:focus-visible .mo__frame { box-shadow: 0 34px 70px -26px rgba(0,0,0,0.95); }
  .mo__item.is-soon .mo__frame { border: 1px dashed var(--line-strong); }

  /* equerres de visee : tracees au survol seulement */
  .mo__frame .mark { position: absolute; width: 13px; height: 13px; z-index: 2; }
  .mo__frame .mark.tl { top: 11px; left: 11px; }
  .mo__frame .mark.br { bottom: 11px; right: 11px; }
  .mo__frame .mark .arm-h { transform: scaleX(0); }
  .mo__frame .mark .arm-v { transform: scaleY(0); }
  .mo__item:hover .mo__frame .mark .arm-h,
  .mo__item:focus-visible .mo__frame .mark .arm-h { transform: scaleX(1); transition: transform var(--dur-sign) var(--ease); }
  .mo__item:hover .mo__frame .mark .arm-v,
  .mo__item:focus-visible .mo__frame .mark .arm-v { transform: scaleY(1); transition: transform var(--dur-sign) var(--ease); }

  /* legende : le numero en colonne, le titre et la meta a cote */
  .mo__cap {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    align-items: baseline;
    margin-top: 14px;
  }
  .mo__num {
    grid-row: span 2;
    font-family: var(--font-mono); font-weight: 500; font-size: 0.6rem;
    letter-spacing: 0.14em; color: var(--accent);
  }
  .mo__titre {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(0.9rem, 1.35vw, 1.25rem); line-height: 1.15;
    color: var(--text-faint);
    transition: color var(--dur-sign) var(--ease);
  }
  .mo__item:hover .mo__titre,
  .mo__item:focus-visible .mo__titre { color: var(--text); }
  .mo__meta {
    grid-column: 2;
    font-family: var(--font-mono); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.56rem; color: var(--text-muted);
    margin-top: 3px;
  }

  /* hors categorie filtree */
  .mo__item.is-out { opacity: 0.14; pointer-events: none; }

  @media (max-width: 900px) {
    /* la composition n'a plus de sens sur une colonne : on empile, sans decalage */
    .mo { grid-template-columns: 1fr; width: 100%; gap: clamp(26px, 6vw, 44px); }
    .mo__item { grid-column: 1 !important; margin-top: 0 !important; }
    .mo__frame { aspect-ratio: 16 / 9 !important; }
  }

  /* ---------- En coulisses — mini galerie BTS ---------- */
  .bts {
    background:
      radial-gradient(55% 46% at 0% 50%, rgba(52,98,175,0.22) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(55% 46% at 100% 50%, rgba(52,98,175,0.16) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(44px, 7vw, 92px);
  }
  .bts__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 38px);
  }
  .bts__hint { font-size: 0.84rem; }
</style>

<script is:inline>
  (function () {
    var mo = document.getElementById("mo");
    if (!mo) return;

    var cats = Array.prototype.slice.call(document.querySelectorAll(".cat"));
    var catsRow = document.querySelector(".cats__row");
    var sigframe = document.querySelector(".cats .sigframe");
    var items = Array.prototype.slice.call(mo.querySelectorAll(".mo__item"));
    var selected = "all"; // categorie verrouillee (clic), persiste

    // Indicateur signature : le cadre 2 coins enveloppe la categorie active.
    function moveIndicator(btn) {
      if (!sigframe || !btn) return;
      var PAD = 9;
      sigframe.style.opacity = "1";
      sigframe.style.transform = "translate(" + (btn.offsetLeft - PAD) + "px," + (btn.offsetTop - PAD) + "px)";
      sigframe.style.width = btn.offsetWidth + PAD * 2 + "px";
      sigframe.style.height = btn.offsetHeight + PAD * 2 + "px";
      sigframe.classList.remove("is-drawn");
      void sigframe.offsetWidth; // reflow, reinitialise le trace
      sigframe.classList.add("is-drawn");
    }

    // Lecture au survol uniquement : une seule video a la fois. C'est plus
    // calme qu'une page ou tout bouge, et ca laisse le processeur libre pour
    // les transitions entre pages.
    function arreterTout(sauf) {
      items.forEach(function (it) {
        var v = it.querySelector("video");
        if (v && v !== sauf) { try { v.pause(); v.currentTime = 0; } catch (e) {} }
      });
    }
    items.forEach(function (it) {
      var v = it.querySelector("video");
      if (!v) return;
      var lire = function () {
        if (it.classList.contains("is-out")) return;
        arreterTout(v);
        var pr = v.play();
        if (pr && pr.catch) pr.catch(function () {});
      };
      it.addEventListener("mouseenter", lire);
      it.addEventListener("focus", lire);
      it.addEventListener("mouseleave", function () { try { v.pause(); } catch (e) {} });
      it.addEventListener("blur", function () { try { v.pause(); } catch (e) {} });
    });

    // Filtre : les projets hors categorie s'effacent et sortent du clavier.
    function applyFilter(cat) {
      var visible = 0;
      items.forEach(function (it) {
        var on = cat === "all" || it.getAttribute("data-category") === cat;
        if (on) visible++;
        it.classList.toggle("is-out", !on);
        if (on) { it.removeAttribute("tabindex"); it.removeAttribute("aria-hidden"); }
        else {
          it.setAttribute("tabindex", "-1");
          it.setAttribute("aria-hidden", "true");
          var v = it.querySelector("video"); if (v) v.pause();
        }
      });
      // categorie sans projet : on reaffiche tout plutot qu'une page vide
      if (!visible) items.forEach(function (it) {
        it.classList.remove("is-out");
        it.removeAttribute("tabindex"); it.removeAttribute("aria-hidden");
      });
    }

    function syncPressed() {
      cats.forEach(function (b) {
        b.setAttribute("aria-pressed", b.getAttribute("data-filter") === selected ? "true" : "false");
      });
    }

    cats.forEach(function (btn) {
      var f = function () { moveIndicator(btn); applyFilter(btn.getAttribute("data-filter")); };
      btn.addEventListener("mouseenter", f);
      btn.addEventListener("focus", f);
      btn.addEventListener("click", function () {
        selected = btn.getAttribute("data-filter");
        syncPressed(); moveIndicator(btn); applyFilter(selected);
      });
    });
    if (catsRow) catsRow.addEventListener("mouseleave", function () {
      moveIndicator(document.querySelector('.cat[aria-pressed="true"]') || cats[0]);
      applyFilter(selected);
    });

    var place = function () {
      var a = document.querySelector('.cat[aria-pressed="true"]') || cats[0];
      moveIndicator(a);
    };
    place(); setTimeout(place, 200);
    window.addEventListener("load", place);
    window.addEventListener("resize", place);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);

    // Rien ne tourne quand la section est hors champ.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (!e.isIntersecting) arreterTout(null); });
      }, { threshold: 0.05 }).observe(mo);
    }
  })();
</script>
