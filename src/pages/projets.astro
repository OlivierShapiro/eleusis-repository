---
/**
 * Projets : en-tête à fond vidéo, puis « l'affiche ».
 * En tête, un grand cadre figé sur le dernier projet réalisé (champ `latest`
 * des données), qui le dit et mène à sa fiche. Dessous, la rangée des autres
 * projets, en accès direct. Pas de filtre : la sélection est trop courte pour
 * qu'un tri serve à quelque chose.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SouvenirsBoard from "../components/SouvenirsBoard.astro";
import { projects } from "../data/projects";

// Disposition « En coulisses » (page Projets) : même contenu que la page
// À propos (src/data/souvenirs.ts) mais éparpillé AUTREMENT (plus colonné).
const coulissesLayout = [
  { t: "10%", l: "5%",  w: "clamp(150px, 15vw, 220px)", r: "3deg",    cap: "Sur le tournage", align: "left",  p: -20 },
  { t: "46%", l: "1%",  w: "clamp(150px, 16vw, 235px)", r: "-2.5deg", cap: "L'équipe",        align: "left",  p: 18 },
  { t: "1%",  l: "37%", w: "clamp(150px, 16vw, 230px)", r: "1.5deg",  cap: "En repérage",     align: "left",  p: 24 },
  { t: "53%", l: "39%", w: "clamp(150px, 15vw, 215px)", r: "-3deg",   cap: "Direction",       align: "right", p: -16 },
  { t: "6%",  l: "72%", w: "clamp(150px, 16vw, 235px)", r: "2.5deg",  cap: "Au montage",      align: "right", p: 20 },
  { t: "50%", l: "74%", w: "clamp(150px, 15vw, 220px)", r: "-1.5deg", cap: "Coulisses",       align: "right", p: -22 },
];

// Le grand cadre est fige sur le dernier projet realise (champ `latest`).
// Il ne redescend jamais dans la rangee : celle-ci ne montre que les autres.
const dernier = projects.find((p) => p.latest) ?? projects.filter((p) => !p.placeholder)[0];
const autres = projects
  .map((p, i) => ({ p, num: String(i + 1).padStart(2, "0") }))
  .filter((x) => x.p !== dernier);

---

<BaseLayout
  title="Projets · Eleusis"
  description="Sélection de réalisations Eleusis : films de marque, social, clips, documentaires."
  active="/projets"
>
  <!-- ============ EN-TÊTE (fond vidéo) ============ -->
  <section class="phead">
    <video class="phead__bg" data-autoplay autoplay muted loop playsinline preload="metadata">
      <source src="/videos/projets-bg.mp4" type="video/mp4" />
    </video>
    <div class="phead__scrim" aria-hidden="true"></div>
    <div class="container phead__inner">
      <p class="label label--accent" data-reveal>// Sélection</p>
      <h1 class="phead__title" data-split>Projets</h1>
    </div>
  </section>

  <!-- ============ PROJETS ============ -->
  <section class="projects">

    <!-- L'AFFICHE : en tete le dernier projet realise, toujours le meme, puis
         la rangee des autres projets. Hors de .container pour la largeur. -->
    <div class="af" id="af" data-reveal>

      <a
        class="af__scene"
        href={dernier.placeholder ? "/projets" : `/projets/${dernier.slug}`}
        aria-label={`${dernier.title}, notre dernier projet réalisé`}
      >
        <span class="af__media">
          {dernier.cardVideo ? (
            <video
              src={dernier.cardVideo}
              poster={dernier.cardPoster}
              muted loop playsinline preload="none"
            ></video>
          ) : (
            <span class="coming-soon"><span class="coming-soon__grad"></span></span>
          )}
        </span>

        <span class="af__voile" aria-hidden="true"></span>
        <span class="mark tl" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
        <span class="mark br" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>

        <span class="af__tag">// Notre dernier projet réalisé</span>

        <span class="af__info">
          <h2 class="af__titre">{dernier.title}</h2>
          <span class="af__coteD">
            <span class="af__meta">
              {dernier.cardType}{dernier.year ? " · " + dernier.year : ""}
            </span>
            <span class="af__lien">
              <span>Voir le projet</span>
              <i class="af__fleche" aria-hidden="true"></i>
            </span>
          </span>
        </span>
      </a>

      <div class="af__rang">
        {autres.map(({ p, num }) => {
          const dedans = (
            <>
              <span class="af__vigMedia">
                {p.cardVideo ? (
                  <video
                    src={p.cardVideo}
                    poster={p.cardPoster}
                    muted loop playsinline preload="none"
                  ></video>
                ) : (
                  <span class="coming-soon"><span class="coming-soon__grad"></span></span>
                )}
              </span>
              <span class="af__vigVoile" aria-hidden="true"></span>
              <span class="af__vigNum" aria-hidden="true">{num}</span>
              <span class="af__vigBas">
                <span class="af__vigTitre">{p.title}</span>
                <span class="af__vigTag">{p.placeholder ? "À venir" : p.cardType}</span>
              </span>
            </>
          );
          return p.placeholder ? (
            /* rien a ouvrir : ni lien ni bouton, sinon on tabule dessus pour rien */
            <div class="af__vig is-soon">{dedans}</div>
          ) : (
            <a
              class="af__vig"
              href={`/projets/${p.slug}`}
              aria-label={`${p.title}, ${p.cardType}`}
            >{dedans}</a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ EN COULISSES : mini galerie BTS ============ -->
  <section class="bts">
    <div class="container">
      <div class="bts__head" data-reveal>
        <p class="label label--accent">// En coulisses</p>
        <p class="bts__hint text-muted">L'envers du décor, sur le terrain.</p>
      </div>
      <SouvenirsBoard layout={coulissesLayout} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- En-tête fond vidéo ---------- */
  .phead { position: relative; overflow: hidden; background: #0f0f11;
    padding-top: calc(var(--nav-h) + clamp(56px, 14vh, 170px)); padding-bottom: clamp(48px, 9vw, 110px); }
  .phead__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8) brightness(0.5); }
  .phead__scrim { position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 78% -8%, rgba(40,70,120,0.28) 0%, rgba(20,20,28,0) 50%),
      linear-gradient(to top, rgba(15,15,17,0.92) 0%, rgba(15,15,17,0.35) 55%, rgba(15,15,17,0.6) 100%); }
  .phead__inner { position: relative; z-index: 2; }
  .phead__title { font-size: clamp(3.5rem, 14vw, 11rem); letter-spacing: 0.01em; margin-top: 0.1em; }

  /* ---------- Section roue (dégradés bleus en fond) ---------- */
  .projects {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(52% 44% at 100% 50%, rgba(52,98,175,0.26) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(52% 44% at 0% 50%, rgba(52,98,175,0.20) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-bottom: clamp(48px, 8vw, 110px);
  }

  /* ---------- Catégories : barre de régie ----------
     Passées du gros display à du mono petit et espacé, dans le meme langage
     que les incrustations du mur. Séparées par de fins traits verticaux et
     posées sur une réglure, comme un bandeau de commande. */
  /* ---------- L'AFFICHE : grand cadre + rangée de vignettes ----------
     Un seul projet occupe le grand cadre, la rangée sert de sélection.
     L'échelle est dans l'image et dans le titre, pas dans les bordures. */
  .af {
    width: min(94vw, 1560px);
    margin: clamp(24px, 3.6vw, 48px) auto 0;
  }

  /* --- le grand cadre (le « programme ») --- */
  .af__scene {
    display: block; position: relative;
    width: 100%;
    aspect-ratio: 12 / 5;
    max-height: 46vh;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-deep);
  }
  .af__scene:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .af__media { position: absolute; inset: 0; display: block; }
  .af__media :global(video),
  .af__media :global(.coming-soon) {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .af__media :global(video) {
    object-fit: cover; display: block;
    scale: 1; transition: scale 1.1s var(--ease);
  }
  .af__scene:hover .af__media :global(video) { scale: 1.025; }

  /* voile : lisibilité du texte, plus dense en bas à gauche */
  .af__voile {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to top, rgba(8,8,11,0.90) 0%, rgba(8,8,11,0.34) 30%, rgba(8,8,11,0) 60%),
      linear-gradient(to right, rgba(8,8,11,0.62) 0%, rgba(8,8,11,0) 46%);
  }

  /* Equerres de visee : le global les laisse a scale(0) et ne les trace que
     via .is-drawn. Ici on les pose nous-memes, courtes au repos, et elles
     s'allongent au survol : c'est le geste signature du site, pas un ajout. */
  .af__scene .mark { position: absolute; width: 22px; height: 22px; z-index: 3; }
  .af__scene .mark.tl { top: 15px; left: 15px; }
  .af__scene .mark.br { bottom: 15px; right: 15px; }
  .af__scene .mark .arm-h { width: 22px; }
  .af__scene .mark .arm-v { height: 22px; }
  .af__scene .mark .arm-h,
  .af__scene .mark .arm-v {
    opacity: 0.62;
    transition: transform 0.5s var(--ease), opacity 0.5s var(--ease);
  }
  .af__scene .mark .arm-h { transform: scaleX(0.5); }
  .af__scene .mark .arm-v { transform: scaleY(0.5); }
  .af__scene:hover .mark .arm-h,
  .af__scene:focus-visible .mark .arm-h { transform: scaleX(1); opacity: 1; }
  .af__scene:hover .mark .arm-v,
  .af__scene:focus-visible .mark .arm-v { transform: scaleY(1); opacity: 1; }

  /* mention en tete : l'equerre puis le libelle, sur la meme ligne */
  .af__tag {
    position: absolute; z-index: 4; top: 13px; left: 41px;
    font-family: var(--font-mono); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.18em;
    font-size: 0.6rem; color: var(--accent);
    text-shadow: 0 1px 6px rgba(0,0,0,0.9);
  }

  /* --- le bloc de texte, en bas à gauche du cadre --- */
  .af__info {
    position: absolute; z-index: 4;
    left: clamp(18px, 2.6vw, 44px);
    right: clamp(18px, 2.6vw, 44px);
    bottom: clamp(16px, 2.2vw, 36px);
    /* titre a gauche, type et lien a droite, cales sur la meme ligne de base :
       la composition occupe la largeur du cadre au lieu de se tasser dans un coin */
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: clamp(20px, 3vw, 56px);
  }
  .af__coteD {
    display: grid; gap: 8px; justify-items: end; text-align: right;
    flex: 0 0 auto; padding-bottom: 4px;
  }
  .af__titre {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.9rem, 5.4vw, 5rem); line-height: 1;
    letter-spacing: -0.01em; color: var(--text);
    text-shadow: 0 2px 26px rgba(0,0,0,0.62);
    min-width: 0; max-width: 15ch;
  }
  .af__meta {
    font-family: var(--font-mono); text-transform: uppercase;
    letter-spacing: 0.14em; font-size: 0.62rem; color: var(--text-muted);
    text-shadow: 0 1px 6px rgba(0,0,0,0.9);
  }
  .af__lien {
    display: inline-flex; align-items: center; gap: 0.7em;
    /* le lien, c'est tout le cadre : ceci n'est que la marque visuelle */
    font-family: var(--font-mono); font-weight: 500; text-transform: uppercase;
    letter-spacing: 0.16em; font-size: 0.66rem; color: var(--text);
    padding-bottom: 4px; border-bottom: 1px solid var(--line-strong);
    transition: color var(--dur-sign) var(--ease), border-color var(--dur-sign) var(--ease);
  }
  .af__scene:hover .af__lien { color: var(--accent); border-color: var(--accent); }
  .af__fleche {
    width: 16px; height: 1.5px; background: currentColor; position: relative;
    transition: transform var(--dur-sign) var(--ease);
  }
  .af__fleche::after {
    content: ""; position: absolute; right: 0; top: -3px;
    width: 7px; height: 1.5px; background: currentColor;
    transform: rotate(42deg); transform-origin: right center;
  }
  .af__scene:hover .af__fleche { transform: translateX(5px); }

  /* --- la rangée de vignettes (la sélection) --- */
  .af__rang {
    display: flex; gap: 6px;
    height: clamp(190px, 30vh, 300px);
    margin-top: 6px;
  }
  .af__vig {
    position: relative;
    /* les projets tournes sont larges, ceux a venir restent etroits : la
       rangee prend un rythme et le poids va sur ce qui existe vraiment */
    flex: 1.3 1 0; min-width: 0; height: 100%;
    overflow: hidden; border-radius: 2px;
    background: var(--bg-deep);
    text-align: left;
    /* remise a zero : les vignettes sont tantot <a>, tantot <button> (a venir),
       il faut qu'elles fassent exactement la meme largeur */
    display: block; appearance: none; -webkit-appearance: none;
    border: 0; padding: 0; margin: 0;
    font: inherit; color: inherit; cursor: pointer;
    transition: flex-grow 0.5s var(--ease);
  }

  .af__vig.is-soon { flex: 0.7 1 0; cursor: default; }

  .af__vigMedia { position: absolute; inset: 0; display: block; }
  .af__vigMedia :global(video),
  .af__vigMedia :global(.coming-soon) {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .af__vigMedia :global(video) {
    object-fit: cover; display: block;
    /* au repos les vignettes sont en retrait : une seule chose est allumée */
    filter: brightness(0.5);
    scale: 1;
    transition: filter 0.5s var(--ease), scale 0.9s var(--ease);
  }
  .af__vig:hover .af__vigMedia :global(video) { filter: brightness(1); scale: 1.05; }

  .af__vigVoile {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(8,8,11,0.88) 0%, rgba(8,8,11,0.18) 42%, rgba(8,8,11,0) 68%);
  }
  .af__vigNum {
    position: absolute; top: 14px; left: 14px;
    font-family: var(--font-mono); font-weight: 500; font-size: 0.6rem;
    letter-spacing: 0.16em; color: var(--text-muted);
    text-shadow: 0 1px 5px rgba(0,0,0,0.9);
    transition: color var(--dur-sign) var(--ease);
  }
  .af__vig:hover .af__vigNum { color: var(--accent); }

  .af__vigBas {
    position: absolute; left: 14px; right: 14px; bottom: 14px;
    display: grid; gap: 4px;
  }
  .af__vigTitre {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(0.82rem, 1.12vw, 1.05rem); line-height: 1.12;
    color: var(--text); text-shadow: 0 1px 6px rgba(0,0,0,0.9);
    overflow: hidden;
  }
  .af__vigTag {
    font-family: var(--font-mono); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.58rem; color: var(--text-muted);
    text-shadow: 0 1px 5px rgba(0,0,0,0.9);
  }

  /* filet rose en tete au survol : la vignette visee se detache de la rangee */
  .af__vig::after {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--accent); z-index: 2;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-sign) var(--ease);
  }
  .af__vig:hover::after, .af__vig:focus-visible::after { transform: scaleX(1); }
  .af__vig:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 900px) {
    /* le cadre reprend un format d'image, la rangée devient une bande qui file */
    .af { width: 100%; }
    .af__scene { aspect-ratio: 16 / 9; max-height: none; border-radius: 0; }
    .af__titre { font-size: clamp(1.6rem, 8vw, 2.6rem); max-width: none; }
    .af__rang {
      height: clamp(150px, 26vh, 210px);
      overflow-x: auto; overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-inline: 12px;
    }
    .af__info { flex-direction: column; align-items: flex-start; gap: 8px; }
    .af__coteD { justify-items: start; text-align: left; padding-bottom: 0; }
    .af__vig {
      flex: 0 0 clamp(116px, 34vw, 168px);
      /* accroche au bord gauche : « center » empeche la premiere et la
         derniere vignette de se poser, le defilement bute aux extremites */
      scroll-snap-align: start;
    }
    .af__vig.is-soon { flex: 0 0 clamp(84px, 24vw, 118px); }
    .af__vigMedia :global(video) { filter: brightness(0.62); }
  }
  /* ---------- En coulisses : mini galerie BTS ---------- */
  .bts {
    background:
      radial-gradient(55% 46% at 0% 50%, rgba(52,98,175,0.22) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(55% 46% at 100% 50%, rgba(52,98,175,0.16) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(44px, 7vw, 92px);
  }
  .bts__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 38px);
  }
  .bts__hint { font-size: 0.84rem; }
</style>

<script is:inline>
  (function () {
    var af = document.getElementById("af");
    if (!af) return;

    var scene = af.querySelector(".af__scene");
    var vigs = Array.prototype.slice.call(af.querySelectorAll(".af__vig"));

    // Animations reduites : on ne lance rien du tout, le poster tient lieu
    // d'image. Le moteur du site gere deja ce cas, mais seulement pour les
    // videos marquees data-autoplay, et les notres sont pilotees ici.
    var reduire = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Les gardes sur v.paused evitent d'appeler play() a chaque image de
    // defilement sur une video qui tourne deja : une promesse allouee pour rien.
    function jouer(v) {
      if (!v || !v.paused) return;
      var pr = v.play();
      if (pr && pr.catch) pr.catch(function () {});
    }
    function stopper(v) {
      if (!v || v.paused) return;
      try { v.pause(); } catch (e) {}
    }

    // On mesure au moment ou on en a besoin plutot que de retenir un etat :
    // l'observateur peut tres bien avoir rapporte « hors champ » a un instant
    // ou la mise en page n'etait pas finie, et ne jamais se corriger ensuite.
    function dansLaVue() {
      var r = af.getBoundingClientRect();
      return r.width > 0 && r.bottom > 0 && r.top < (window.innerHeight || 0);
    }

    // Le cadre en tete et les vignettes ne tournent que section a l'ecran.
    function reglerLecture() {
      var on = !reduire && dansLaVue();
      var tout = [scene.querySelector("video")];
      vigs.forEach(function (x) { tout.push(x.querySelector("video")); });
      tout.forEach(function (v) { if (on) jouer(v); else stopper(v); });
    }

    if (reduire) return; // rien a piloter : le poster reste affiche, point

    // A l'arrivee par transition, le gabarit met en pause tout ce qui demarre
    // tant que le panneau couvre l'ecran. Quand il se retire, on reapplique
    // notre regle : sinon les vignettes restent figees jusqu'au rafraichissement.
    document.addEventListener("pgt:fin", reglerLecture);
    // Retour par l'historique : la page ressort du cache telle qu'elle etait.
    window.addEventListener("pageshow", reglerLecture);

    // L'observateur ne suffit pas : il ne delivre pas toujours, et une seule
    // notification manquee laisse les vignettes figees pour de bon. On ecoute
    // donc aussi le defilement, limite a une mesure par image.
    var enAttente = false;
    function auDefilement() {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(function () { enAttente = false; reglerLecture(); });
    }
    window.addEventListener("scroll", auDefilement, { passive: true });
    window.addEventListener("resize", auDefilement, { passive: true });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(reglerLecture, { threshold: 0 }).observe(af);
    }
    reglerLecture();
  })();
</script>
