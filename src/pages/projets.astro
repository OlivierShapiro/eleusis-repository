---
/**
 * Projets : en-tête à fond vidéo, puis « l'affiche ».
 * Un grand cadre montre un seul projet à la fois (le programme) ; la rangée
 * de vignettes en dessous sert de sélection. Survol d'une vignette : le cadre
 * bascule en fondu et le bloc de texte se remet à jour. Clic : on entre dans
 * le projet. Les catégories au-dessus filtrent la rangée.
 * 6 projets, dont 3 « à venir » (placeholders, sans page détaillée).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SouvenirsBoard from "../components/SouvenirsBoard.astro";
import { projects } from "../data/projects";

const total = String(projects.length).padStart(2, "0");

// Disposition « En coulisses » (page Projets) : même contenu que la page
// À propos (src/data/souvenirs.ts) mais éparpillé AUTREMENT (plus colonné).
const coulissesLayout = [
  { t: "10%", l: "5%",  w: "clamp(150px, 15vw, 220px)", r: "3deg",    cap: "Sur le tournage", align: "left",  p: -20 },
  { t: "46%", l: "1%",  w: "clamp(150px, 16vw, 235px)", r: "-2.5deg", cap: "L'équipe",        align: "left",  p: 18 },
  { t: "1%",  l: "37%", w: "clamp(150px, 16vw, 230px)", r: "1.5deg",  cap: "En repérage",     align: "left",  p: 24 },
  { t: "53%", l: "39%", w: "clamp(150px, 15vw, 215px)", r: "-3deg",   cap: "Direction",       align: "right", p: -16 },
  { t: "6%",  l: "72%", w: "clamp(150px, 16vw, 235px)", r: "2.5deg",  cap: "Au montage",      align: "right", p: 20 },
  { t: "50%", l: "74%", w: "clamp(150px, 15vw, 220px)", r: "-1.5deg", cap: "Coulisses",       align: "right", p: -22 },
];

const baseFilters = [
  { label: "Tous", value: "all" },
  { label: "Brand Film", value: "brand-film" },
  { label: "Publicité", value: "publicite" },
  { label: "Corporate", value: "corporate" },
  { label: "Documentaire", value: "documentaire" },
];
// Disposition des clips sur la timeline de montage : t = piste (1 = V1, 2 = V2),
// x = point d'entrée et w = durée, en % de la durée totale. Calibré pour un
// étagement naturel (les clips d'une même piste ne se chevauchent jamais).
const clips = [
  { t: 1, x: 0,  w: 22 },
  { t: 2, x: 16, w: 20 },
  { t: 1, x: 26, w: 24 },
  { t: 2, x: 42, w: 16 },
  { t: 1, x: 54, w: 20 },
  { t: 2, x: 64, w: 30 },
];
// Graduations de la règle (durée fictive du « montage » : 2 min).
const ticks = Array.from({ length: 21 }, (_, k) => k * 5);
const tcMarks = [
  { x: 0, l: "00:00" }, { x: 25, l: "00:30" }, { x: 50, l: "01:00" },
  { x: 75, l: "01:30" }, { x: 100, l: "02:00" },
];

const counts: Record<string, number> = { all: projects.length };
for (const p of projects) counts[p.category] = (counts[p.category] || 0) + 1;
const filters = baseFilters.map((f) => ({
  ...f,
  count: String(counts[f.value] || 0).padStart(2, "0"),
}));
---

<BaseLayout
  title="Projets · Eleusis"
  description="Sélection de réalisations Eleusis : films de marque, social, clips, documentaires."
  active="/projets"
>
  <!-- ============ EN-TÊTE (fond vidéo) ============ -->
  <section class="phead">
    <video class="phead__bg" data-autoplay autoplay muted loop playsinline preload="metadata">
      <source src="/videos/projets-bg.mp4" type="video/mp4" />
    </video>
    <div class="phead__scrim" aria-hidden="true"></div>
    <div class="container phead__inner">
      <p class="label label--accent" data-reveal>// Sélection</p>
      <h1 class="phead__title" data-split>Projets</h1>
    </div>
  </section>

  <!-- ============ ROUE DE CARTES ============ -->
  <section class="projects">
    <div class="container">
      <!-- Catégories au-dessus (déclencheurs) -->
      <div class="cats" role="group" aria-label="Catégories de projets" data-reveal>
        <div class="cats__row">
          {filters.map((f, i) => (
            <button class="cat" type="button" data-filter={f.value} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="cat__label">{f.label}</span>
              <span class="cat__count">{f.count}</span>
            </button>
          ))}
          <span class="sigframe" aria-hidden="true">
            <span class="mark tl"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
            <span class="mark br"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
          </span>
        </div>
      </div>

    </div>

    <!-- L'AFFICHE : un grand cadre (le programme) piloté par la rangée de
         vignettes. Survol d'une vignette = le cadre bascule, clic = on entre.
         Hors de .container pour occuper toute la largeur utile. -->
    <div class="af" id="af" data-reveal>

      <div class="af__scene">
        {projects.map((p, i) => (
          <div
            class:list={["af__plan", { "is-on": i === 0 }]}
            aria-hidden={i === 0 ? undefined : "true"}
          >
            {p.placeholder ? (
              <span class="coming-soon">
                <span class="coming-soon__grad"></span>
                <span class="coming-soon__label">Prochainement</span>
              </span>
            ) : (
              <video src={p.cardVideo} muted loop playsinline preload="metadata"></video>
            )}
          </div>
        ))}

        <span class="af__voile" aria-hidden="true"></span>
        <span class="mark tl" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
        <span class="mark br" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>

        <div class="af__info">
          <p class="af__compte" aria-hidden="true"><span id="afNum">01</span> / {total}</p>
          <h2 class="af__titre" id="afTitre">{projects[0].title}</h2>
          <p class="af__meta" id="afMeta">
            {projects[0].cardType}{projects[0].year ? " · " + projects[0].year : ""}
          </p>
          <a class="af__lien" id="afLien" href={`/projets/${projects[0].slug}`}>
            <span>Voir le projet</span>
            <i class="af__fleche" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="af__rang">
        {projects.map((p, i) => {
          const meta = p.placeholder
            ? "À venir"
            : p.cardType + (p.year ? " · " + p.year : "");
          const num = String(i + 1).padStart(2, "0");
          const dedans = (
            <>
              <span class="af__vigMedia">
                {p.placeholder ? (
                  <span class="coming-soon"><span class="coming-soon__grad"></span></span>
                ) : (
                  <video src={p.cardVideo} muted loop playsinline preload="metadata"></video>
                )}
              </span>
              <span class="af__vigVoile" aria-hidden="true"></span>
              <span class="af__vigNum" aria-hidden="true">{num}</span>
              <span class="af__vigBas">
                <span class="af__vigTitre">{p.title}</span>
                <span class="af__vigTag">{p.placeholder ? "À venir" : p.cardType}</span>
              </span>
            </>
          );
          return p.placeholder ? (
            <button
              class:list={["af__vig", "is-soon", { "is-on": i === 0 }]}
              type="button"
              data-category={p.category}
              data-titre={p.title}
              data-meta={meta}
              data-href=""
              aria-label={`${p.title}, à venir`}
              aria-current={i === 0 ? "true" : undefined}
            >{dedans}</button>
          ) : (
            <a
              class:list={["af__vig", { "is-on": i === 0 }]}
              href={`/projets/${p.slug}`}
              data-category={p.category}
              data-titre={p.title}
              data-meta={meta}
              data-href={`/projets/${p.slug}`}
              aria-label={`${p.title}, ${p.cardType}`}
              aria-current={i === 0 ? "true" : undefined}
            >{dedans}</a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ EN COULISSES : mini galerie BTS ============ -->
  <section class="bts">
    <div class="container">
      <div class="bts__head" data-reveal>
        <p class="label label--accent">// En coulisses</p>
        <p class="bts__hint text-muted">L'envers du décor, sur le terrain.</p>
      </div>
      <SouvenirsBoard layout={coulissesLayout} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- En-tête fond vidéo ---------- */
  .phead { position: relative; overflow: hidden; background: #0f0f11;
    padding-top: calc(var(--nav-h) + clamp(56px, 14vh, 170px)); padding-bottom: clamp(48px, 9vw, 110px); }
  .phead__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8) brightness(0.5); }
  .phead__scrim { position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 78% -8%, rgba(40,70,120,0.28) 0%, rgba(20,20,28,0) 50%),
      linear-gradient(to top, rgba(15,15,17,0.92) 0%, rgba(15,15,17,0.35) 55%, rgba(15,15,17,0.6) 100%); }
  .phead__inner { position: relative; z-index: 2; }
  .phead__title { font-size: clamp(3.5rem, 14vw, 11rem); letter-spacing: 0.01em; margin-top: 0.1em; }

  /* ---------- Section roue (dégradés bleus en fond) ---------- */
  .projects {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(52% 44% at 100% 50%, rgba(52,98,175,0.26) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(52% 44% at 0% 50%, rgba(52,98,175,0.20) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-bottom: clamp(48px, 8vw, 110px);
  }

  /* ---------- Catégories : barre de régie ----------
     Passées du gros display à du mono petit et espacé, dans le meme langage
     que les incrustations du mur. Séparées par de fins traits verticaux et
     posées sur une réglure, comme un bandeau de commande. */
  .cats { padding-block: clamp(24px, 3.6vw, 44px); }
  .cats__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0; /* l'espacement vient du padding des items */
    padding-bottom: 14px;
  }
  /* réglure fine sous la barre, arrêtée avant les bords */
  .cats__row::after {
    content: "";
    position: absolute; left: 12%; right: 12%; bottom: 0; height: 1px;
    background: linear-gradient(to right, rgba(255,255,255,0) 0%, var(--line) 18%, var(--line) 82%, rgba(255,255,255,0) 100%);
  }
  .cat {
    position: relative;
    display: inline-flex; align-items: baseline; gap: 0.55em;
    padding: 0.4em clamp(13px, 1.9vw, 26px);
    font-family: var(--font-mono); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.16em;
    font-size: 0.82rem; line-height: 1;
    color: var(--text-faint);
    transition: color var(--dur-sign) var(--ease);
  }
  /* trait vertical entre deux catégories */
  .cat + .cat::before {
    content: "";
    position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 1px; height: 10px; background: var(--line-strong);
  }
  .cat:hover, .cat[aria-pressed="true"] { color: var(--text); }
  .cat__count {
    font-family: var(--font-mono); font-weight: 500;
    font-size: 0.62em; letter-spacing: 0.06em; color: var(--accent);
    align-self: flex-start; margin-top: -0.1em;
  }

  /* ---------- L'AFFICHE : grand cadre + rangée de vignettes ----------
     Un seul projet occupe le grand cadre, la rangée sert de sélection.
     L'échelle est dans l'image et dans le titre, pas dans les bordures. */
  .af {
    width: min(94vw, 1560px);
    margin: clamp(24px, 3.6vw, 48px) auto 0;
  }

  /* --- le grand cadre (le « programme ») --- */
  .af__scene {
    position: relative;
    width: 100%;
    aspect-ratio: 12 / 5;
    max-height: 46vh;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-deep);
  }
  /* un calque par projet, empilés : seul le courant est visible */
  .af__plan {
    position: absolute; inset: 0;
    opacity: 0; scale: 1.045;
    transition: opacity 0.5s var(--ease), scale 0.9s var(--ease);
  }
  .af__plan.is-on { opacity: 1; scale: 1; }
  .af__plan :global(video),
  .af__plan :global(.coming-soon) {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .af__plan :global(video) { object-fit: cover; display: block; }

  /* voile : lisibilité du texte, plus dense en bas à gauche */
  .af__voile {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to top, rgba(8,8,11,0.90) 0%, rgba(8,8,11,0.34) 30%, rgba(8,8,11,0) 60%),
      linear-gradient(to right, rgba(8,8,11,0.62) 0%, rgba(8,8,11,0) 46%);
  }

  .af__scene .mark { position: absolute; width: 16px; height: 16px; z-index: 3; }
  .af__scene .mark.tl { top: 16px; left: 16px; }
  .af__scene .mark.br { bottom: 16px; right: 16px; }

  /* --- le bloc de texte, en bas à gauche du cadre --- */
  .af__info {
    position: absolute; z-index: 4;
    left: clamp(18px, 2.6vw, 44px);
    right: clamp(18px, 2.6vw, 44px);
    bottom: clamp(16px, 2.2vw, 36px);
    display: grid; gap: 6px; justify-items: start;
    transition: opacity 0.38s var(--ease), transform 0.38s var(--ease);
  }
  /* pendant la bascule : le texte sort, se met à jour, revient */
  .af__info.is-out {
    opacity: 0; transform: translateY(10px);
    transition-duration: 0.17s;
  }
  .af__compte {
    font-family: var(--font-mono); font-weight: 500;
    font-size: 0.6rem; letter-spacing: 0.2em; color: var(--text-muted);
    text-shadow: 0 1px 6px rgba(0,0,0,0.9);
  }
  .af__compte :global(span) { color: var(--accent); }
  .af__titre {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.9rem, 5.4vw, 5rem); line-height: 1;
    letter-spacing: -0.01em; color: var(--text);
    text-shadow: 0 2px 26px rgba(0,0,0,0.62);
    max-width: 15ch;
  }
  .af__meta {
    font-family: var(--font-mono); text-transform: uppercase;
    letter-spacing: 0.14em; font-size: 0.62rem; color: var(--text-muted);
    text-shadow: 0 1px 6px rgba(0,0,0,0.9);
  }
  .af__lien {
    display: inline-flex; align-items: center; gap: 0.7em;
    margin-top: clamp(6px, 0.9vw, 14px);
    font-family: var(--font-mono); font-weight: 500; text-transform: uppercase;
    letter-spacing: 0.16em; font-size: 0.66rem; color: var(--text);
    padding-bottom: 4px; border-bottom: 1px solid var(--line-strong);
    transition: color var(--dur-sign) var(--ease), border-color var(--dur-sign) var(--ease);
  }
  .af__lien[hidden] { display: none; }
  .af__lien:hover { color: var(--accent); border-color: var(--accent); }
  .af__fleche {
    width: 16px; height: 1.5px; background: currentColor; position: relative;
    transition: transform var(--dur-sign) var(--ease);
  }
  .af__fleche::after {
    content: ""; position: absolute; right: 0; top: -3px;
    width: 7px; height: 1.5px; background: currentColor;
    transform: rotate(42deg); transform-origin: right center;
  }
  .af__lien:hover .af__fleche { transform: translateX(5px); }

  /* --- la rangée de vignettes (la sélection) --- */
  .af__rang {
    display: flex; gap: 6px;
    height: clamp(190px, 30vh, 300px);
    margin-top: 6px;
  }
  .af__vig {
    position: relative;
    flex: 1 1 0; min-width: 0; height: 100%;
    overflow: hidden; border-radius: 2px;
    background: var(--bg-deep);
    text-align: left;
    /* remise a zero : les vignettes sont tantot <a>, tantot <button> (a venir),
       il faut qu'elles fassent exactement la meme largeur */
    display: block; appearance: none; -webkit-appearance: none;
    border: 0; padding: 0; margin: 0;
    font: inherit; color: inherit; cursor: pointer;
    transition: flex-grow 0.5s var(--ease);
  }
  .af__vig.is-out { display: none; }

  .af__vigMedia { position: absolute; inset: 0; display: block; }
  .af__vigMedia :global(video),
  .af__vigMedia :global(.coming-soon) {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .af__vigMedia :global(video) {
    object-fit: cover; display: block;
    /* au repos les vignettes sont en retrait : une seule chose est allumée */
    filter: brightness(0.5);
    scale: 1;
    transition: filter 0.5s var(--ease), scale 0.9s var(--ease);
  }
  .af__vig:hover .af__vigMedia :global(video) { filter: brightness(0.78); scale: 1.04; }
  .af__vig.is-on .af__vigMedia :global(video) { filter: brightness(1); scale: 1; }

  .af__vigVoile {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(8,8,11,0.88) 0%, rgba(8,8,11,0.18) 42%, rgba(8,8,11,0) 68%);
  }
  .af__vigNum {
    position: absolute; top: 12px; left: 12px;
    font-family: var(--font-mono); font-weight: 500; font-size: 0.56rem;
    letter-spacing: 0.16em; color: var(--text-muted);
    text-shadow: 0 1px 5px rgba(0,0,0,0.9);
    transition: color var(--dur-sign) var(--ease);
  }
  .af__vig.is-on .af__vigNum { color: var(--accent); }

  .af__vigBas {
    position: absolute; left: 12px; right: 12px; bottom: 12px;
    display: grid; gap: 3px;
  }
  .af__vigTitre {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(0.66rem, 0.86vw, 0.84rem); line-height: 1.15;
    color: var(--text); text-shadow: 0 1px 6px rgba(0,0,0,0.9);
    overflow: hidden;
  }
  .af__vigTag {
    font-family: var(--font-mono); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.52rem; color: var(--text-muted);
    text-shadow: 0 1px 5px rgba(0,0,0,0.9);
  }

  /* vignette courante : liseré rose + filet en tête, c'est elle qui est au cadre */
  .af__vig.is-on { box-shadow: inset 0 0 0 1.5px var(--accent); }
  .af__vig.is-on::after {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--accent); z-index: 2;
  }
  .af__vig:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 900px) {
    /* le cadre reprend un format d'image, la rangée devient une bande qui file */
    .af { width: 100%; }
    .af__scene { aspect-ratio: 16 / 9; max-height: none; border-radius: 0; }
    .af__titre { font-size: clamp(1.6rem, 8vw, 2.6rem); max-width: none; }
    .af__rang {
      height: clamp(150px, 26vh, 210px);
      overflow-x: auto; overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-inline: 12px;
    }
    .af__vig {
      flex: 0 0 clamp(116px, 34vw, 168px);
      /* accroche au bord gauche : « center » empeche la premiere et la
         derniere vignette de se poser, le defilement bute aux extremites */
      scroll-snap-align: start;
    }
    .af__vigMedia :global(video) { filter: brightness(0.62); }
  }
  /* ---------- En coulisses : mini galerie BTS ---------- */
  .bts {
    background:
      radial-gradient(55% 46% at 0% 50%, rgba(52,98,175,0.22) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(55% 46% at 100% 50%, rgba(52,98,175,0.16) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(44px, 7vw, 92px);
  }
  .bts__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 38px);
  }
  .bts__hint { font-size: 0.84rem; }
</style>

<script is:inline>
  (function () {
    var af = document.getElementById("af");
    if (!af) return;

    var cats = Array.prototype.slice.call(document.querySelectorAll(".cat"));
    var catsRow = document.querySelector(".cats__row");
    var sigframe = document.querySelector(".cats .sigframe");

    var plans = Array.prototype.slice.call(af.querySelectorAll(".af__plan"));
    var vigs = Array.prototype.slice.call(af.querySelectorAll(".af__vig"));
    var info = af.querySelector(".af__info");
    var elNum = document.getElementById("afNum");
    var elTitre = document.getElementById("afTitre");
    var elMeta = document.getElementById("afMeta");
    var elLien = document.getElementById("afLien");

    var courant = 0;
    var selected = "all"; // categorie verrouillee au clic, persiste
    var tempo = null;
    var visible = true;
    // au doigt il n'y a pas de survol : le premier appui sert a viser
    var tactile = window.matchMedia("(hover: none)").matches;

    function deuxChiffres(n) { return n < 10 ? "0" + n : String(n); }

    // Indicateur signature : le cadre 2 coins enveloppe la categorie active.
    function moveIndicator(btn) {
      if (!sigframe || !btn) return;
      var PAD = 9;
      sigframe.style.opacity = "1";
      sigframe.style.transform = "translate(" + (btn.offsetLeft - PAD) + "px," + (btn.offsetTop - PAD) + "px)";
      sigframe.style.width = btn.offsetWidth + PAD * 2 + "px";
      sigframe.style.height = btn.offsetHeight + PAD * 2 + "px";
      sigframe.classList.remove("is-drawn");
      void sigframe.offsetWidth; // reflow, reinitialise le trace
      sigframe.classList.add("is-drawn");
    }

    function jouer(v) {
      if (!v) return;
      var pr = v.play();
      if (pr && pr.catch) pr.catch(function () {});
    }
    function stopper(v) { if (v) { try { v.pause(); } catch (e) {} } }

    // Le grand cadre ne joue que le projet courant ; les vignettes visibles
    // tournent en boucle, celles qui sont filtrees ou hors champ s'arretent.
    function reglerLecture() {
      plans.forEach(function (p, k) {
        var v = p.querySelector("video");
        if (visible && k === courant) jouer(v); else stopper(v);
      });
      vigs.forEach(function (x) {
        var v = x.querySelector("video");
        if (visible && !x.classList.contains("is-out")) jouer(v); else stopper(v);
      });
    }

    function poser(i) {
      if (i === courant || !vigs[i] || vigs[i].classList.contains("is-out")) return;
      courant = i;

      plans.forEach(function (p, k) {
        var on = k === i;
        p.classList.toggle("is-on", on);
        if (on) p.removeAttribute("aria-hidden");
        else p.setAttribute("aria-hidden", "true");
      });
      vigs.forEach(function (x, k) {
        var on = k === i;
        x.classList.toggle("is-on", on);
        if (on) x.setAttribute("aria-current", "true");
        else x.removeAttribute("aria-current");
      });

      // le texte sort, se met a jour hors champ, puis revient
      var v = vigs[i];
      info.classList.add("is-out");
      clearTimeout(tempo);
      tempo = setTimeout(function () {
        elNum.textContent = deuxChiffres(i + 1);
        elTitre.textContent = v.getAttribute("data-titre") || "";
        elMeta.textContent = v.getAttribute("data-meta") || "";
        var h = v.getAttribute("data-href");
        if (h) { elLien.setAttribute("href", h); elLien.hidden = false; }
        else { elLien.hidden = true; }
        info.classList.remove("is-out");
      }, 170);

      reglerLecture();
    }

    vigs.forEach(function (v, i) {
      v.addEventListener("mouseenter", function () { poser(i); });
      v.addEventListener("focus", function () { poser(i); });
      v.addEventListener("click", function (e) {
        // au doigt : un appui vise, le suivant (ou le lien du cadre) entre
        if (tactile && courant !== i) { e.preventDefault(); poser(i); }
      });
    });

    // Filtre : les vignettes hors categorie quittent la rangee.
    function applyFilter(cat) {
      var premiere = -1;
      vigs.forEach(function (v, i) {
        var on = cat === "all" || v.getAttribute("data-category") === cat;
        v.classList.toggle("is-out", !on);
        if (on) {
          if (premiere < 0) premiere = i;
          v.removeAttribute("tabindex"); v.removeAttribute("aria-hidden");
        } else {
          v.setAttribute("tabindex", "-1"); v.setAttribute("aria-hidden", "true");
        }
      });
      // categorie sans projet : on remontre tout plutot qu'une rangee vide
      if (premiere < 0) {
        vigs.forEach(function (v) {
          v.classList.remove("is-out");
          v.removeAttribute("tabindex"); v.removeAttribute("aria-hidden");
        });
        reglerLecture();
        return;
      }
      // si la vignette au cadre vient d'etre filtree, on en pose une visible
      if (vigs[courant].classList.contains("is-out")) {
        var cible = premiere;
        courant = -1;
        poser(cible);
      } else {
        reglerLecture();
      }
    }

    function syncPressed() {
      cats.forEach(function (b) {
        b.setAttribute("aria-pressed", b.getAttribute("data-filter") === selected ? "true" : "false");
      });
    }

    cats.forEach(function (btn) {
      var f = function () { moveIndicator(btn); applyFilter(btn.getAttribute("data-filter")); };
      btn.addEventListener("mouseenter", f);
      btn.addEventListener("focus", f);
      btn.addEventListener("click", function () {
        selected = btn.getAttribute("data-filter");
        syncPressed(); moveIndicator(btn); applyFilter(selected);
      });
    });
    if (catsRow) catsRow.addEventListener("mouseleave", function () {
      moveIndicator(document.querySelector('.cat[aria-pressed="true"]') || cats[0]);
      applyFilter(selected);
    });

    var place = function () {
      var a = document.querySelector('.cat[aria-pressed="true"]') || cats[0];
      moveIndicator(a);
    };
    place(); setTimeout(place, 200);
    window.addEventListener("load", place);
    window.addEventListener("resize", place);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);

    // Rien ne tourne quand la section est hors champ.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { visible = e.isIntersecting; });
        reglerLecture();
      }, { threshold: 0.1 }).observe(af);
    } else {
      reglerLecture();
    }
    reglerLecture();
  })();
</script>
