---
/**
 * Projets : en-tête à fond vidéo, moniteur pilote par la liste des projets.
 * « roue de cartes » : catégories au-dessus (déclencheurs au survol),
 * cartes en éventail/arc en bas. Au survol d'une catégorie : spin rapide +
 * les projets de la catégorie grandissent au centre, les autres reculent.
 * Cartes en vignette statique (perf). Dégradés bleus en arrière-plan.
 * 6 projets. Contenus = PLACEHOLDERS.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SouvenirsBoard from "../components/SouvenirsBoard.astro";
import { projects } from "../data/projects";

const total = String(projects.length).padStart(2, "0");

// Disposition « En coulisses » (page Projets) : même contenu que la page
// À propos (src/data/souvenirs.ts) mais éparpillé AUTREMENT (plus colonné).
const coulissesLayout = [
  { t: "10%", l: "5%",  w: "clamp(150px, 15vw, 220px)", r: "3deg",    cap: "Sur le tournage", align: "left",  p: -20 },
  { t: "46%", l: "1%",  w: "clamp(150px, 16vw, 235px)", r: "-2.5deg", cap: "L'équipe",        align: "left",  p: 18 },
  { t: "1%",  l: "37%", w: "clamp(150px, 16vw, 230px)", r: "1.5deg",  cap: "En repérage",     align: "left",  p: 24 },
  { t: "53%", l: "39%", w: "clamp(150px, 15vw, 215px)", r: "-3deg",   cap: "Direction",       align: "right", p: -16 },
  { t: "6%",  l: "72%", w: "clamp(150px, 16vw, 235px)", r: "2.5deg",  cap: "Au montage",      align: "right", p: 20 },
  { t: "50%", l: "74%", w: "clamp(150px, 15vw, 220px)", r: "-1.5deg", cap: "Coulisses",       align: "right", p: -22 },
];

const baseFilters = [
  { label: "Tous", value: "all" },
  { label: "Brand Film", value: "brand-film" },
  { label: "Publicité", value: "publicite" },
  { label: "Corporate", value: "corporate" },
  { label: "Documentaire", value: "documentaire" },
];
// Disposition des clips sur la timeline de montage : t = piste (1 = V1, 2 = V2),
// x = point d'entrée et w = durée, en % de la durée totale. Calibré pour un
// étagement naturel (les clips d'une même piste ne se chevauchent jamais).
const clips = [
  { t: 1, x: 0,  w: 22 },
  { t: 2, x: 16, w: 20 },
  { t: 1, x: 26, w: 24 },
  { t: 2, x: 42, w: 16 },
  { t: 1, x: 54, w: 20 },
  { t: 2, x: 64, w: 30 },
];
// Graduations de la règle (durée fictive du « montage » : 2 min).
const ticks = Array.from({ length: 21 }, (_, k) => k * 5);
const tcMarks = [
  { x: 0, l: "00:00" }, { x: 25, l: "00:30" }, { x: 50, l: "01:00" },
  { x: 75, l: "01:30" }, { x: 100, l: "02:00" },
];

const counts: Record<string, number> = { all: projects.length };
for (const p of projects) counts[p.category] = (counts[p.category] || 0) + 1;
const filters = baseFilters.map((f) => ({
  ...f,
  count: String(counts[f.value] || 0).padStart(2, "0"),
}));
---

<BaseLayout
  title="Projets · Eleusis"
  description="Sélection de réalisations Eleusis : films de marque, social, clips, documentaires."
  active="/projets"
>
  <!-- ============ EN-TÊTE (fond vidéo) ============ -->
  <section class="phead">
    <video class="phead__bg" data-autoplay autoplay muted loop playsinline preload="metadata">
      <source src="/videos/projets-bg.mp4" type="video/mp4" />
    </video>
    <div class="phead__scrim" aria-hidden="true"></div>
    <div class="container phead__inner">
      <p class="label label--accent" data-reveal>// Sélection</p>
      <h1 class="phead__title" data-split>Projets</h1>
    </div>
  </section>

  <!-- ============ ROUE DE CARTES ============ -->
  <section class="projects">
    <div class="container">
      <!-- Catégories au-dessus (déclencheurs) -->
      <div class="cats" role="group" aria-label="Catégories de projets" data-reveal>
        <div class="cats__row">
          {filters.map((f, i) => (
            <button class="cat" type="button" data-filter={f.value} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="cat__label">{f.label}</span>
              <span class="cat__count">{f.count}</span>
            </button>
          ))}
          <span class="sigframe" aria-hidden="true">
            <span class="mark tl"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
            <span class="mark br"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
          </span>
        </div>
      </div>

    </div>

      <!-- Le viseur : moniteur (couvertures empilées) + liste qui le pilote -->
      <div class="vf" id="vf" data-reveal>
        <div class="vf__monitor">
          <div class="vf__screen">
            {projects.map((p, i) => (
              <div class:list={["vf__slide", { "is-active": i === 0 }]} data-slide={i} aria-hidden="true">
                {p.placeholder ? (
                  <div class="coming-soon">
                    <div class="coming-soon__grad"></div>
                    <span class="coming-soon__label">Prochainement</span>
                  </div>
                ) : (
                  <video src={p.cardVideo} muted loop playsinline preload="metadata"></video>
                )}
              </div>
            ))}
            <span class="vf__grid" aria-hidden="true"></span>
          </div>
          <!-- HUD du viseur -->
          <span class="mark tl is-drawn" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
          <span class="mark br is-drawn" aria-hidden="true"><i class="arm arm-h"></i><i class="arm arm-v"></i></span>
          <span class="vf__rec" aria-hidden="true"><i></i>REC</span>
          <span class="vf__now" aria-hidden="true">01 // {total}</span>
          <span class="vf__tc" aria-hidden="true">00:00:00:00</span>
        </div>

        <ol class="vf__list">
          {projects.map((p, i) => (
            <li class="vf__row" data-category={p.category}>
              <a
                class:list={["vf__item", { "is-active": i === 0 }]}
                data-i={i}
                data-type={p.placeholder ? "À venir" : p.cardType}
                href={p.placeholder ? "/projets" : `/projets/${p.slug}`}
                aria-current={i === 0 ? "true" : undefined}
              >
                <span class="vf__num">{String(i + 1).padStart(2, "0")}</span>
                <span class="vf__title">{p.title}</span>
                <span class="vf__type">{p.placeholder ? "À venir" : p.cardType}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ EN COULISSES : mini galerie BTS ============ -->
  <section class="bts">
    <div class="container">
      <div class="bts__head" data-reveal>
        <p class="label label--accent">// En coulisses</p>
        <p class="bts__hint text-muted">L'envers du décor, sur le terrain.</p>
      </div>
      <SouvenirsBoard layout={coulissesLayout} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- En-tête fond vidéo ---------- */
  .phead { position: relative; overflow: hidden; background: #0f0f11;
    padding-top: calc(var(--nav-h) + clamp(56px, 14vh, 170px)); padding-bottom: clamp(48px, 9vw, 110px); }
  .phead__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8) brightness(0.5); }
  .phead__scrim { position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 78% -8%, rgba(40,70,120,0.28) 0%, rgba(20,20,28,0) 50%),
      linear-gradient(to top, rgba(15,15,17,0.92) 0%, rgba(15,15,17,0.35) 55%, rgba(15,15,17,0.6) 100%); }
  .phead__inner { position: relative; z-index: 2; }
  .phead__title { font-size: clamp(3.5rem, 14vw, 11rem); letter-spacing: 0.01em; margin-top: 0.1em; }

  /* ---------- Section roue (dégradés bleus en fond) ---------- */
  .projects {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(52% 44% at 100% 50%, rgba(52,98,175,0.26) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(52% 44% at 0% 50%, rgba(52,98,175,0.20) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-bottom: clamp(48px, 8vw, 110px);
  }

  /* ---------- Catégories : barre de régie ----------
     Passées du gros display à du mono petit et espacé, dans le meme langage
     que les incrustations du mur. Séparées par de fins traits verticaux et
     posées sur une réglure, comme un bandeau de commande. */
  .cats { padding-block: clamp(24px, 3.6vw, 44px); }
  .cats__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0; /* l'espacement vient du padding des items */
    padding-bottom: 14px;
  }
  /* réglure fine sous la barre, arrêtée avant les bords */
  .cats__row::after {
    content: "";
    position: absolute; left: 12%; right: 12%; bottom: 0; height: 1px;
    background: linear-gradient(to right, rgba(255,255,255,0) 0%, var(--line) 18%, var(--line) 82%, rgba(255,255,255,0) 100%);
  }
  .cat {
    position: relative;
    display: inline-flex; align-items: baseline; gap: 0.55em;
    padding: 0.4em clamp(13px, 1.9vw, 26px);
    font-family: var(--font-mono); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.16em;
    font-size: 0.82rem; line-height: 1;
    color: var(--text-faint);
    transition: color var(--dur-sign) var(--ease);
  }
  /* trait vertical entre deux catégories */
  .cat + .cat::before {
    content: "";
    position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 1px; height: 10px; background: var(--line-strong);
  }
  .cat:hover, .cat[aria-pressed="true"] { color: var(--text); }
  .cat__count {
    font-family: var(--font-mono); font-weight: 500;
    font-size: 0.62em; letter-spacing: 0.06em; color: var(--accent);
    align-self: flex-start; margin-top: -0.1em;
  }

  /* ---------- LE VISEUR : moniteur + liste des projets ---------- */
  .vf {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: clamp(26px, 4vw, 64px);
    margin-top: clamp(20px, 3vw, 40px);
  }

  /* --- Moniteur --- */
  .vf__monitor {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-deep);
    border-radius: 2px;
    box-shadow: 0 30px 80px -30px rgba(0,0,0,0.85);
  }
  .vf__screen { position: absolute; inset: 0; overflow: hidden; border-radius: 2px; background: #000; }
  /* couvertures empilées : une seule visible, les autres prêtes (pas de recharge) */
  .vf__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    scale: 1.04;
    filter: blur(12px) saturate(0.55);
    transition:
      opacity 0.45s var(--ease),
      scale 0.7s var(--ease),
      filter 0.7s var(--ease);
  }
  /* mise au point faite : net, à l'échelle, visible */
  .vf__slide.is-active { opacity: 1; scale: 1; filter: blur(0) saturate(1); }
  /* le « focus pull » : on repart flou une fraction de seconde au changement */
  .vf__screen.is-pulling .vf__slide.is-active { scale: 1.04; filter: blur(12px) saturate(0.55); }
  .vf__slide :global(video),
  .vf__slide :global(.coming-soon) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .vf__slide :global(video) { object-fit: cover; display: block; }
  /* repères de cadrage (règle des tiers), très discrets */
  .vf__grid {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.16;
    background:
      linear-gradient(to right, transparent 33.33%, rgba(255,255,255,0.5) 33.33%, rgba(255,255,255,0.5) calc(33.33% + 1px), transparent calc(33.33% + 1px)),
      linear-gradient(to right, transparent 66.66%, rgba(255,255,255,0.5) 66.66%, rgba(255,255,255,0.5) calc(66.66% + 1px), transparent calc(66.66% + 1px)),
      linear-gradient(to bottom, transparent 33.33%, rgba(255,255,255,0.5) 33.33%, rgba(255,255,255,0.5) calc(33.33% + 1px), transparent calc(33.33% + 1px)),
      linear-gradient(to bottom, transparent 66.66%, rgba(255,255,255,0.5) 66.66%, rgba(255,255,255,0.5) calc(66.66% + 1px), transparent calc(66.66% + 1px));
  }
  /* équerres de visée dans les coins */
  .vf__monitor .mark { position: absolute; width: 14px; height: 14px; z-index: 3; pointer-events: none; }
  .vf__monitor .mark.tl { top: 14px; left: 14px; }
  .vf__monitor .mark.br { bottom: 14px; right: 14px; }
  /* HUD : REC, compteur, timecode */
  .vf__rec, .vf__now, .vf__tc {
    position: absolute; z-index: 3; pointer-events: none;
    font-family: var(--font-mono); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.6rem;
    color: var(--text); text-shadow: 0 1px 6px rgba(0,0,0,0.8);
  }
  .vf__rec { top: 14px; left: 38px; display: inline-flex; align-items: center; gap: 7px; }
  .vf__rec i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: vf-rec 2s ease-in-out infinite; }
  @keyframes vf-rec { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
  .vf__now { top: 16px; right: 14px; color: var(--text-muted); }
  .vf__tc { bottom: 16px; right: 38px; color: var(--text-muted); }

  /* --- Liste des projets (pilote le moniteur) --- */
  .vf__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .vf__row { border-bottom: 1px solid var(--line); }
  .vf__row.is-hidden { display: none; }
  .vf__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: clamp(10px, 1.4vw, 18px);
    padding: clamp(13px, 1.5vw, 20px) 2px;
  }
  /* soulignement accent qui se trace sous l'étape visée */
  .vf__item::after {
    content: "";
    position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-sign) var(--ease);
  }
  .vf__item.is-active::after { transform: scaleX(1); }
  .vf__num { font-family: var(--font-mono); font-weight: 500; font-size: 0.66rem; letter-spacing: 0.1em; color: var(--text-faint); transition: color var(--dur-sign) var(--ease); }
  .vf__item.is-active .vf__num { color: var(--accent); }
  .vf__title {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.01em; line-height: 1.05;
    font-size: clamp(1.05rem, 1.9vw, 1.6rem);
    color: var(--text-faint);
    transition: color var(--dur-sign) var(--ease), transform var(--dur-sign) var(--ease);
  }
  .vf__item.is-active .vf__title { color: var(--text); transform: translateX(4px); }
  .vf__type {
    font-family: var(--font-mono); font-weight: 500; text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.6rem; color: var(--text-faint);
    transition: color var(--dur-sign) var(--ease);
  }
  .vf__item.is-active .vf__type { color: var(--text-muted); }

  @media (max-width: 860px) {
    /* mobile : le moniteur passe au-dessus, la liste dessous */
    .vf { grid-template-columns: 1fr; gap: 22px; }
  }

  /* ---------- En coulisses : mini galerie BTS ---------- */
  .bts {
    background:
      radial-gradient(55% 46% at 0% 50%, rgba(52,98,175,0.22) 0%, rgba(18,18,20,0) 80%),
      radial-gradient(55% 46% at 100% 50%, rgba(52,98,175,0.16) 0%, rgba(18,18,20,0) 80%),
      var(--bg-base);
    padding-block: clamp(44px, 7vw, 92px);
  }
  .bts__head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 16px; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 38px);
  }
  .bts__hint { font-size: 0.84rem; }
</style>

<script is:inline>
  (function () {
    var vf = document.getElementById("vf");
    if (!vf) return;

    var cats = Array.prototype.slice.call(document.querySelectorAll(".cat"));
    var catsRow = document.querySelector(".cats__row");
    var sigframe = document.querySelector(".cats .sigframe");
    var screenEl = vf.querySelector(".vf__screen");
    var slides = Array.prototype.slice.call(vf.querySelectorAll(".vf__slide"));
    var items = Array.prototype.slice.call(vf.querySelectorAll(".vf__item"));
    var rows = Array.prototype.slice.call(vf.querySelectorAll(".vf__row"));
    var tcEl = vf.querySelector(".vf__tc");
    var nowEl = vf.querySelector(".vf__now");

    function pad(n) { return (n < 10 ? "0" : "") + n; }
    var TOTAL = pad(items.length);

    var selected = "all"; // catégorie verrouillée (clic), persiste
    var current = 0;      // projet actuellement « à l'image »

    // Indicateur signature : le cadre 2 coins enveloppe la catégorie active.
    function moveIndicator(btn) {
      if (!sigframe || !btn) return;
      var PAD = 9;
      sigframe.style.opacity = "1";
      sigframe.style.transform = "translate(" + (btn.offsetLeft - PAD) + "px," + (btn.offsetTop - PAD) + "px)";
      sigframe.style.width = btn.offsetWidth + PAD * 2 + "px";
      sigframe.style.height = btn.offsetHeight + PAD * 2 + "px";
      sigframe.classList.remove("is-drawn");
      void sigframe.offsetWidth; // reflow → réinitialise le tracé
      sigframe.classList.add("is-drawn");
    }

    function videoOf(i) { return slides[i] ? slides[i].querySelector("video") : null; }

    function playCurrent() {
      var v = videoOf(current);
      if (!v) return;
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }

    // Mise au point sur le projet i : la couverture bascule dans le moniteur
    // avec un « focus pull » (flou → net), pilotée par la liste.
    function activate(i) {
      if (i === current || !items[i]) return;
      var prev = videoOf(current);
      if (prev) prev.pause();

      slides.forEach(function (s, k) { s.classList.toggle("is-active", k === i); });
      items.forEach(function (a, k) {
        a.classList.toggle("is-active", k === i);
        if (k === i) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });

      // on repart flou, puis on laisse la transition faire le point
      screenEl.classList.add("is-pulling");
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { screenEl.classList.remove("is-pulling"); });
      });

      current = i;
      if (nowEl) nowEl.textContent = pad(i + 1) + " // " + TOTAL;
      playCurrent();
    }

    // Timecode : lu sur la vidéo à l'image (HH:MM:SS:FF, base 25 i/s).
    var raf = 0;
    function tick() {
      if (tcEl) {
        var v = videoOf(current);
        if (v && !isNaN(v.currentTime)) {
          var t = v.currentTime;
          tcEl.textContent =
            pad(Math.floor(t / 3600)) + ":" + pad(Math.floor(t / 60) % 60) + ":" +
            pad(Math.floor(t) % 60) + ":" + pad(Math.floor((t % 1) * 25));
        } else {
          tcEl.textContent = "--:--:--:--";
        }
      }
      raf = requestAnimationFrame(tick);
    }
    function startTC() { if (!raf) raf = requestAnimationFrame(tick); }
    function stopTC() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }

    // Filtre : masque les lignes hors catégorie. Le projet à l'image reste
    // affiché s'il appartient à la catégorie, sinon on vise le premier.
    function applyFilter(cat) {
      var firstVisible = -1, currentVisible = false;
      rows.forEach(function (r, i) {
        var match = cat === "all" || r.getAttribute("data-category") === cat;
        r.classList.toggle("is-hidden", !match);
        if (match) {
          if (firstVisible < 0) firstVisible = i;
          if (i === current) currentVisible = true;
        }
      });
      // catégorie sans projet → on réaffiche tout (pas de liste vide)
      if (firstVisible < 0) {
        rows.forEach(function (r) { r.classList.remove("is-hidden"); });
        return;
      }
      if (!currentVisible) activate(firstVisible);
    }

    // La liste pilote le moniteur (survol + clavier). Le clic suit le lien.
    items.forEach(function (a, i) {
      a.addEventListener("mouseenter", function () { activate(i); });
      a.addEventListener("focus", function () { activate(i); });
    });

    function syncPressed() {
      cats.forEach(function (b) {
        b.setAttribute("aria-pressed", b.getAttribute("data-filter") === selected ? "true" : "false");
      });
    }

    cats.forEach(function (btn) {
      var f = function () { moveIndicator(btn); applyFilter(btn.getAttribute("data-filter")); };
      btn.addEventListener("mouseenter", f);
      btn.addEventListener("focus", f);
      btn.addEventListener("click", function () {
        selected = btn.getAttribute("data-filter");
        syncPressed(); moveIndicator(btn); applyFilter(selected);
      });
    });
    // quitter la rangée → revenir à la sélection verrouillée
    if (catsRow) catsRow.addEventListener("mouseleave", function () {
      moveIndicator(document.querySelector('.cat[aria-pressed="true"]') || cats[0]);
      applyFilter(selected);
    });

    var place = function () {
      var a = document.querySelector('.cat[aria-pressed="true"]') || cats[0];
      moveIndicator(a);
    };
    place(); setTimeout(place, 200);
    window.addEventListener("load", place);
    window.addEventListener("resize", place);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(place);

    // Lecture + timecode uniquement quand la section est visible (perf).
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { playCurrent(); startTC(); }
          else {
            stopTC();
            slides.forEach(function (s) { var v = s.querySelector("video"); if (v) v.pause(); });
          }
        });
      }, { threshold: 0.15 }).observe(vf);
    } else { playCurrent(); startTC(); }
  })();
</script>
